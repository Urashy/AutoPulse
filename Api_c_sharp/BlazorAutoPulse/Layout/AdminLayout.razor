@using BlazorAutoPulse.ViewModel
@inherits LayoutComponentBase
@inject AdminLayoutViewModel VM

@if (VM.IsLoading)
{
    <div class="admin-loading">
        <div class="loader"></div>
        <p>Vérification des permissions...</p>
    </div>
}
else if (VM.IsVerified)
{
    <div class="admin-layout">
        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <div class="sidebar-header">
                <h2>AutoPulse</h2>
                <p class="admin-badge">ADMIN</p>
            </div>


            <nav class="sidebar-nav">
                <a href="/admin" class="@VM.GetNavItemClass("/admin")">
                    <span class="icon">📊</span>
                    <span class="text">Tableau de bord</span>
                </a>
                <a href="/admin/signalements" class="@VM.GetNavItemClass("/admin/signalements")">
                    <span class="icon">🚩</span>
                    <span class="text">Signalements</span>
                </a>
                <a href="/admin/annonces" class="@VM.GetNavItemClass("/admin/annonces")">
                    <span class="icon">🚗</span>
                    <span class="text">Annonces</span>
                </a>
                <a href="/admin/utilisateurs" class="@VM.GetNavItemClass("/admin/utilisateurs")">
                    <span class="icon">👥</span>
                    <span class="text">Utilisateurs</span>
                </a>
                <a href="/admin/journaux" class="@VM.GetNavItemClass("/admin/journaux")">
                    <span class="icon">📰</span>
                    <span class="text">Journaux</span>
                </a>
                <div class="nav-divider"></div>
                <a href="/" class="nav-item nav-exit">
                    <span class="icon">←</span>
                    <span class="text">Mode Normal</span>
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="admin-content">
            @Body
        </main>
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await VM.InitializeAsync(StateHasChanged);
    }
}