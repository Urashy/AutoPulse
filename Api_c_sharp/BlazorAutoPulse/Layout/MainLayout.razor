@using BlazorAutoPulse.Service.Interface
@using BlazorAutoPulse.Service.WebService
@using BlazorAutoPulse.Services
@using BlazorAutoPulse.ViewModel
@inherits LayoutComponentBase
@inject MainLayoutViewModel VM
@inject ConversationStateService CS
@inject NavigationManager Navigation
@implements IDisposable

<ToastContainer />

@if (VM.IsAccountSuspended)
{
    <!-- Mode compte suspendu -->
    <div class="suspended-layout">
        <div class="suspended-header">
            <div class="suspended-logo">⚠️ AutoPulse</div>
        </div>

        <div class="suspended-content">
            <div class="suspended-card">
                <div class="suspended-icon">🚫</div>
                <h1>Compte Suspendu</h1>
                <p class="suspended-message">
                    Votre compte a été temporairement suspendu par nos équipes.
                </p>



                <p class="suspended-submessage">
                    Si vous pensez qu'il s'agit d'une erreur, vous pouvez contacter nos administrateurs
                    en déposant une plainte ci-dessous.
                </p>

                @if (VM.ShowPlainteForm)
                {
                    <div class="plainte-form">
                        <h3>Déposer une plainte</h3>

                        <div class="form-group">
                            <label>Motif de votre plainte</label>
                            <textarea @bind="VM.PlainteContenu"
                                      placeholder="Expliquez pourquoi vous contestez cette suspension..."
                                      rows="6"
                                      maxlength="1000"
                                      class="form-control"></textarea>
                            <small class="char-count">@VM.PlainteContenu.Length / 1000 caractères</small>
                        </div>

                        @if (!string.IsNullOrEmpty(VM.PlainteError))
                        {
                            <div class="error-message">
                                ⚠️ @VM.PlainteError
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(VM.PlainteSuccess))
                        {
                            <div class="success-message">
                                ✓ @VM.PlainteSuccess
                            </div>
                        }

                        <div class="form-actions">
                            <button class="btn-secondary"
                                    @onclick="VM.CancelPlainte"
                                    disabled="@VM.IsSubmittingPlainte">
                                Annuler
                            </button>
                            <button class="btn-primary"
                                    @onclick="VM.SubmitPlainte"
                                    disabled="@VM.IsSubmittingPlainte">
                                @if (VM.IsSubmittingPlainte)
                                {
                                    <span>Envoi en cours...</span>
                                }
                                else
                                {
                                    <span>Envoyer la plainte</span>
                                }
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <button class="btn-plainte" @onclick="VM.OpenPlainteForm">
                        📝 Déposer une plainte
                    </button>
                }

                <button class="btn-logout" @onclick="VM.LogoutSuspendedAccount">
                    Se déconnecter
                </button>
            </div>
        </div>
    </div>
}
@* Modal Email non vérifié *@
@if (VM.IsConnected && VM.IsEmailNotVerified)
{
    <div class="suspended-overlay">
        <div class="suspended-modal">
            <div class="suspended-icon">📧</div>
            <h2>Email non vérifié</h2>
            <p>Vous devez vérifier votre adresse email pour accéder à toutes les fonctionnalités de la plateforme.</p>
            <p class="info-text">Un email de vérification a été envoyé lors de votre inscription. Veuillez vérifier votre boîte de réception.</p>
            
            <div class="suspended-actions">
                <button @onclick="VM.OpenEmailVerificationModal" class="btn-resend-email">
                    Renvoyer l'email de vérification
                </button>
                <button @onclick="VM.LogoutSuspendedAccount" class="btn-logout-suspended">
                    Se déconnecter
                </button>
            </div>
        </div>
    </div>
}

@* Modal pour renvoyer l'email *@
@if (VM.ShowEmailVerificationModal)
{
    <div class="modal-overlay" @onclick="VM.CloseEmailVerificationModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <h3>Renvoyer l'email de vérification</h3>
            <p>Vous n'avez pas reçu l'email de vérification ? Nous pouvons vous en renvoyer un nouveau.</p>
            
            @if (!string.IsNullOrEmpty(VM.EmailVerificationMessage))
            {
                <div class="verification-message @(VM.EmailVerificationMessage.Contains("✅") ? "success" : "error")">
                    @VM.EmailVerificationMessage
                </div>
            }
            
            <div class="modal-actions">
                <button @onclick="VM.RenvoyerEmailVerification" 
                        class="btn-confirm" 
                        disabled="@VM.IsResendingEmail">
                    @if (VM.IsResendingEmail)
                    {
                        <span>Envoi en cours...</span>
                    }
                    else
                    {
                        <span>Renvoyer l'email</span>
                    }
                </button>
                <button @onclick="VM.CloseEmailVerificationModal" class="btn-cancel">
                    Annuler
                </button>
            </div>
        </div>
    </div>
}
else
{
    <!-- Layout normal -->
    <header>
        <nav>
            <NavLink href="/">
                <span class="logo"> AutoPulse </span>
            </NavLink>
            <ul class="nav-links">
                <NavLink href="vente">
                    <span> Vendre </span>
                </NavLink>
                <NavLink href="favoris">
                    <span> ❤ Favoris</span>
                </NavLink>

                <NavLink href="notifications" class="notifications-link">
                    <span class="conversation-btn">
                        📬 Notifications
                        @if (VM.notificationsCount > 0)
                        {
                            <span class="notification-badge">@VM.notificationsCount</span>
                        }
                    </span>
                </NavLink>

                <NavLink href="conversations" class="conversation-link">
                    <span class="conversation-btn">
                        💬 Conversations
                        @if (VM.unreadCount > 0)
                        {
                            <span class="notification-badge">@VM.unreadCount</span>
                        }
                    </span>
                </NavLink>

                @if (VM.IsConnected)
                {
                    <li class="profile-menu" @onclick="VM.NavigateToProfile">
                        <img src="@VM.ImageSource" alt="Profil" class="profile-picture" data-testid='btn-compte'/>
                    </li>
                }
                else
                {
                    <NavLink href="connexion">
                        <span class="btn-login" data-testid='btn-connexion-layout'> Connexion </span>
                    </NavLink>
                }

                @if (VM.IsAdmin)
                {
                    <NavLink href="admin">
                        <span class="btn-login"> Mode Admin </span>
                    </NavLink>
                }
            </ul>
        </nav>
    </header>

    <div>
        <article class="content">
            @Body
        </article>
    </div>

    <footer>
        <p>&copy; 2025 AutoPulse - Tous droits réservés</p>
        <p>📍 Chambéry, France | 📞 04 XX XX XX XX | ✉️ contact@AutoPulse.fr</p>
        <a href="cgu" class="text-decoration-none mx-2">CGU</a> |
        <a href="confidentialite" class="text-decoration-none mx-2">Confidentialité</a>
    </footer>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await VM.InitializeAsync(StateHasChanged, Navigation, CS);
    }

    public void Dispose()
    {
        VM.Dispose();
    }
}