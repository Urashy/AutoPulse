@using AutoPulse.Shared.DTO

<div class="avis-card">
    <div class="avis-type-badge @(idCompte == Avis.IdJugee ? "badge-received" : "badge-given")">
        @if (idCompte == Avis.IdJugee)
        {
            <span class="badge-icon">📨</span>
            <span>Avis reçu</span>
        }
        else
        {
            <span class="badge-icon">✍️</span>
            <span>Avis posté</span>
        }
    </div>
    
    <div class="avis-content">
        <div class="avis-top">
            <div class="avis-author-section">
                <div class="author-avatar">
                    <span>@GetInitial(Avis.PseudoJugeur)</span>
                </div>
                <div class="author-info">
                    <span class="author-name">@Avis.PseudoJugeur</span>
                    <span class="avis-date">
                        <span class="date-icon">🕒</span>
                        @FormatDate(Avis.DateAvis)
                    </span>
                </div>
            </div>
            
            <div class="avis-rating">
                <div class="rating-stars">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <span class="star @(i <= Avis.NoteAvis ? "filled" : "")">★</span>
                    }
                </div>
                <span class="rating-value">@Avis.NoteAvis/5</span>
            </div>
        </div>
        
        <div class="avis-comment-section">
            @if (!string.IsNullOrEmpty(Avis.ContenuAvis))
            {
                <p class="avis-comment">@Avis.ContenuAvis</p>
            }
            else
            {
                <p class="avis-comment no-comment">
                    <span class="no-comment-icon">💬</span>
                    Aucun commentaire laissé
                </p>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public AvisListDTO Avis { get; set; } = null!;
    
    [Parameter]
    public int idCompte { get; set; }

    private string GetInitial(string? pseudo)
    {
        if (string.IsNullOrEmpty(pseudo))
            return "?";
        return pseudo[0].ToString().ToUpper();
    }

    private string FormatDate(DateTime date)
    {
        var diff = DateTime.Now - date;
        
        if (diff.TotalDays < 1)
            return "Aujourd'hui";
        if (diff.TotalDays < 2)
            return "Hier";
        if (diff.TotalDays < 7)
            return $"Il y a {(int)diff.TotalDays} jours";
        if (diff.TotalDays < 30)
            return $"Il y a {(int)(diff.TotalDays / 7)} semaine" + ((int)(diff.TotalDays / 7) > 1 ? "s" : "");
        if (diff.TotalDays < 365)
            return $"Il y a {(int)(diff.TotalDays / 30)} mois";
        
        return date.ToString("dd/MM/yyyy");
    }
}