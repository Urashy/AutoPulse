@using AutoPulse.Shared.DTO

<div class="card-bancaire">
    <div class="card-front">
        <div class="card-header">
            <div class="card-chip">💳</div>
            <div class="card-type">Carte</div>
        </div>

        <div class="card-number">
            <span>@CarteBancaire.NumeroCarte</span>
        </div>

        <div class="card-footer">
            <div class="card-info">
                <div class="card-label">Expire le</div>
                <div class="card-value">@CarteBancaire.DateExpiration</div>
            </div>
            <div class="card-info">
                <div class="card-label">CVV</div>
                <div class="card-value">
                    <span>@CarteBancaire.CodeSecurite</span>
                </div>
            </div>
        </div>

        @if (IsExpired())
        {
            <div class="card-expired-badge">
                ⚠️ Expirée
            </div>
        }
    </div>

    @if (ShowActions)
    {
        <div class="card-actions">
            <button class="card-btn danger" @onclick="ShowDeleteConfirmation" @onclick:stopPropagation="true">
                <span>🗑️</span>
                <span>Supprimer</span>
            </button>
        </div>
    }
</div>

@if (showConfirmDialog)
{
    <div class="modal-overlay" @onclick="CloseConfirmDialog">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>⚠️ Confirmer la suppression</h3>
            </div>
            <div class="modal-body">
                <p>Si cette carte est associée à un paiement de mise en avant, le paiement sera supprimé.</p>
                <p><strong>Voulez-vous vraiment supprimer cette carte ?</strong></p>
            </div>
            <div class="modal-footer">
                <button class="modal-btn cancel" @onclick="CloseConfirmDialog">
                    Annuler
                </button>
                <button class="modal-btn confirm" @onclick="ConfirmDelete">
                    Oui, supprimer la carte
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public CarteBancaireDTO CarteBancaire { get; set; }

    [Parameter]
    public bool ShowActions { get; set; } = false;

    [Parameter]
    public EventCallback<CarteBancaireDTO> OnDelete { get; set; }

    private bool showConfirmDialog = false;

    private bool IsExpired()
    {
        int mois, annee;

        mois = int.Parse(CarteBancaire.DateExpiration.Substring(0, 2));
        annee = int.Parse("20" + CarteBancaire.DateExpiration.Substring(3, 2));

        var expirationDate = new DateTime(annee, mois, DateTime.DaysInMonth(annee, mois));
        return DateTime.Now > expirationDate;
    }

    private void ShowDeleteConfirmation()
    {
        showConfirmDialog = true;
    }

    private void CloseConfirmDialog()
    {
        showConfirmDialog = false;
    }

    private async Task ConfirmDelete()
    {
        showConfirmDialog = false;

        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync(CarteBancaire);
        }
    }
}