@using AutoPulse.Shared.DTO
@using BlazorAutoPulse.ViewModel
@inject AnnonceComposantViewModel VM
@inject NavigationManager Navigation

<div class="@divClass" @onclick="NavigateToDetail">
    <div class="car-image">
        @if (Annonce.DatePublication >= DateTime.Now.AddMonths(-1))
        {
            <div class="car-badge">RÉCENT</div>
        }

        <div class="favorite-icon @(VM.IsFavorite ? "favorite-active" : "")"
             @onclick="ToggleFavorite"
             @onclick:stopPropagation="true">
            @if (VM.IsFavorite)
            {
                <i class="fas fa-heart"></i>
            }
            else
            {
                <i class="far fa-heart"></i>
            }
        </div>

        <img src="@VM.GetFirstImage(Annonce.IdVoiture)" alt="@Annonce.Libelle" />
    </div>
    <div class="car-info">
        <h3 data-testid="title" class="car-title">@Annonce.Libelle</h3>
        <div class="car-specs">
            <span>📅 @Annonce.Annee</span>
        </div>
        <div class="car-specs">
            <span>📊 @Annonce.Kilometrage km</span>
        </div>
        <div data-testid="prix" class="car-price">@Annonce.Prix?.ToString("N0") €</div>
        <button class="car-btn" @onclick="NavigateToDetail" @onclick:stopPropagation="true">Voir Détails</button>
    </div>
</div>

@code {
    [Parameter]
    public AnnonceDTO Annonce { get; set; }
    
    [Parameter]
    public int? idCompte { get; set; }
    
    [Parameter]
    public string divClass { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Annonce != null)
        {
            await VM.InitializeAsync(Annonce, idCompte, StateHasChanged);
        }
    }

    private async Task ToggleFavorite()
    {
        await VM.ToggleFavoriteStatus(Annonce.IdAnnonce);
    }

    private void NavigateToDetail()
    {
        Navigation.NavigateTo($"/annonce/{Annonce.IdAnnonce}", forceLoad:true);
    }
}