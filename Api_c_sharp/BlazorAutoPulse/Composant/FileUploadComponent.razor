@using BlazorAutoPulse.ViewModel
@using Microsoft.AspNetCore.Components.Forms

<div class="file-upload-inline">
    <InputFile OnChange="@ViewModel.HandleFileSelection"
               multiple
               accept="@ViewModel.AcceptedFileFormats"
               id="fileInputInline"
               style="display: none;" />

    <label for="fileInputInline" class="file-upload-icon-btn" title="Joindre des fichiers">
        📎
    </label>

    @if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
    {
        <div class="file-error-popup">
            <span>⚠️ @ViewModel.ErrorMessage</span>
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback<List<IBrowserFile>> OnFilesSelected { get; set; }

    private FileUploadViewModel ViewModel { get; set; } = new();

    protected override void OnInitialized()
    {
        ViewModel.SetOnFilesSelectedCallback(async (files) =>
        {
            await OnFilesSelected.InvokeAsync(files);
        });
    }
}