@using AutoPulse.Shared.DTO
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<div class="messages-wrapper">
    <div class="messages-container @(IsBlocked ? "blocked" : "")" @ref="_messagesContainerRef">
        @if (IsLoadingMessages)
        {
            <div class="messages-loading">
                <div class="loading-spinner"></div>
                <p>Chargement des messages...</p>
            </div>
        }
        else
        {
            @foreach (var msg in Messages)
            {
                <div class="message @(msg.IdCompte == CurrentUserId ? "sent" : "received")">
                    <div class="message-bubble">
                        <p>@msg.ContenuMessage</p>

                        @if (msg.PiecesJointes != null && msg.PiecesJointes.Any())
                        {
                            <div class="message-attachments">
                                @foreach (var pj in msg.PiecesJointes)
                                {
                                    <div class="attachment-item">
                                        @if (pj.EstImage)
                                        {
                                            <a href="@pj.DataUrl" target="_blank" download="@pj.NomFichier">
                                                <img src="@pj.DataUrl" alt="@pj.NomFichier" class="attachment-image" />
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@pj.DataUrl" class="attachment-file" download="@pj.NomFichier">
                                                <span class="file-icon">@pj.IconeType</span>
                                                <div class="file-details">
                                                    <span class="file-name">@pj.NomFichier</span>
                                                    <span class="file-size">@pj.TailleFormatee</span>
                                                </div>
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        <div class="message-footer">
                            <span class="message-time">@msg.DateEnvoiMessage.ToLocalTime().ToString("HH:mm")</span>
                            @if (msg.IdCompte == CurrentUserId)
                            {
                                <span class="read-indicator">@(msg.EstLu ? "✓✓" : "✓")</span>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (IsTyping)
            {
                <div class="typing-indicator">
                    <span></span><span></span><span></span>
                </div>
            }
        }
    </div>

    @if (IsBlocked)
    {
        <div class="block-overlay">
            <div class="block-card">
                <div class="block-icon-container">
                    <svg class="block-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    <div class="block-pulse"></div>
                </div>
                
                <h3 class="block-title">@BlockTitle</h3>
                <p class="block-message">@BlockMessage</p>
                
                <div class="block-divider"></div>
                
                <button class="btn-primary" @onclick="@RedirectionCompte">
                    Dirigez vous sur son compte pour le débloquer
                </button>
                <p class="block-info">
                    Les messages et interactions sont désormais limités
                </p>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public List<MessageDTO> Messages { get; set; } = new();
    [Parameter] public int CurrentUserId { get; set; }
    [Parameter] public int ParticipantId { get; set; }
    [Parameter] public bool IsLoadingMessages { get; set; }
    [Parameter] public bool IsTyping { get; set; }
    [Parameter] public int? ConversationId { get; set; }
    
    // Paramètres de blocage
    [Parameter] public string BlocageType { get; set; } = "";

    private ElementReference _messagesContainerRef;
    private int? _previousConversationId;
    private int _previousMessageCount = 0;

    private bool IsBlocked => BlocageType == "je suis bloquer" || BlocageType == "est bloquer";
    
    private string BlockTitle => BlocageType == "je suis bloquer" 
        ? "Utilisateur bloqué" 
        : "Vous avez été bloqué";
    
    private string BlockMessage => BlocageType == "je suis bloquer"
        ? "Vous avez bloqué cet utilisateur. Vous ne pouvez plus échanger de messages."
        : "Cet utilisateur vous a bloqué. Vous ne pouvez plus lui envoyer de messages.";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        bool conversationChanged = ConversationId.HasValue && ConversationId != _previousConversationId;
        bool newMessagesAdded = Messages.Count > _previousMessageCount;
        
        if (conversationChanged || newMessagesAdded || IsTyping)
        {
            _previousConversationId = ConversationId;
            _previousMessageCount = Messages.Count;
            await ScrollToBottom();
        }
    }

    public async Task ScrollToBottom()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("scrollToBottom", _messagesContainerRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur scroll: {ex.Message}");
        }
    }

    public async Task RedirectionCompte()
    {
        Nav.NavigateTo($"/comptepublic/{ParticipantId}");
    }
}