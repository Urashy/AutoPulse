@using AutoPulse.Shared.DTO
@using BlazorAutoPulse.ViewModel
@inject CommandeComposantViewModel CommandeVM
@inject NavigationManager Navigation

<div class="commande-card" @onclick="NavigateToCommande">
    <div class="commande-header">
        <div class="commande-icon">
            📍
        </div>
        <h3 class="commande-title">@Commande.LibelleAnnonce</h3>
    </div>

    <div class="commande-content">
        <div class="commande-row">
            <div class="commande-details">
                <span class="commande-label">Numéro de commande</span>
                <span class="commande-value commande-number">
                    #@Commande.IdCommande
                </span>
            </div>
        </div>

        <div class="commande-row">
            <div class="commande-details">
                <span class="commande-label">Moyen de paiement</span>
                <span class="commande-value">
                    @Commande.MoyenPaiement
                </span>
            </div>
        </div>

        <div class="commande-row">
            <span class="commande-row-icon">📮</span>
            <div class="commande-details">
                <span class="commande-label">Vendeur</span>
                <span class="commande-value">
                    @Commande.PseudoVendeur
                </span>
            </div>
        </div>

        <div class="commande-row">
            <div class="commande-details">
                <span class="commande-label">Statut</span>
                <span class="commande-statut @GetStatutClass()">
                    @GetStatutLabel()
                </span>
            </div>
        </div>
    </div>

    @if (ShowActions)
    {
        <div class="commande-actions">
            <button class="commande-btn" @onclick="EditAddress" @onclick:stopPropagation="true">
                <span>✏️</span>
                <span>Modifier</span>
            </button>
            <button class="commande-btn danger" @onclick="DeleteAddress" @onclick:stopPropagation="true">
                <span>🗑️</span>
                <span>Supprimer</span>
            </button>
        </div>
    }

    <div class="commande-link-indicator">
        <span>Voir les détails</span>
        <svg class="link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
    </div>
</div>

@code {
    [Parameter]
    public CommandeDTO Commande { get; set; }

    [Parameter]
    public bool ShowActions { get; set; } = false;

    [Parameter]
    public bool IsPrincipal { get; set; } = false;

    [Parameter]
    public EventCallback<CommandeDTO> OnEdit { get; set; }

    [Parameter]
    public EventCallback<CommandeDTO> OnDelete { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Commande != null)
        {
            await CommandeVM.InitializeAsync(Commande, StateHasChanged);
        }
    }

    private void NavigateToCommande()
    {
        Navigation.NavigateTo($"/commande/{Commande.IdCommande}");
    }

    private async Task EditAddress()
    {
        if (OnEdit.HasDelegate)
        {
            await OnEdit.InvokeAsync(Commande);
        }
    }

    private async Task DeleteAddress()
    {
        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync(Commande);
        }
    }

    private string GetStatutClass()
    {
        return Commande.IdEtatCommande switch
        {
            1 => "statut-attente",
            2 => "statut-paiement",
            3 => "statut-valide",
            4 => "statut-livraison",
            5 => "statut-termine",
            _ => ""
        };
    }

    private string GetStatutLabel()
    {
        return Commande.IdEtatCommande switch
        {
            1 => "En attente de paiement",
            2 => "Paiement émis",
            3 => "Paiement validé",
            4 => "En livraison",
            5 => "Terminée",
            _ => "Inconnu"
        };
    }
}