@page "/commande/{IdCommande:int}"
@using BlazorAutoPulse.ViewModel
@using BlazorAutoPulse.Composant
@inject CommandeDetailViewModel VM
@inject NavigationManager Navigation

<PageTitle>Commande #@IdCommande - AutoPulse</PageTitle>

@* Integration de la Modale de Paiement *@
@if (VM?.Commande != null)
{
    <PaiementModal IsVisible="@VM.ShowPaiementModal"
                   IdCb="@((int value) => VM.SetIdCb(value))"
                   Id="@VM.Commande.IdCommande"
                   Type="commande"
                   IsVisibleChanged="@((bool value) => VM.ShowPaiementModal = value)"
                   OnPaymentSuccess="@VM.OnPaymentSuccess" />
}

@if (VM == null || VM.IsLoading)
{
    <div class="loading-container">
        <div class="loader"></div>
        <p>Chargement de la commande...</p>
    </div>
}
else if (VM.Commande == null)
{
    <div class="error-container">
        <h2>Commande introuvable</h2>
        <p>La commande que vous recherchez n'existe pas.</p>
        <button class="btn-primary" @onclick='() => Navigation.NavigateTo("/compte")'>
            Retour au compte
        </button>
    </div>
}
else
{
    <div class="commande-detail-container">
        <div class="commande-header">
            <div class="header-left">
                <button class="btn-back" @onclick='() => Navigation.NavigateTo("/compte")'>
                    ← Retour
                </button>
                <h1>Commande #@VM.Commande.IdCommande</h1>
            </div>
            <div class="statut-badge @VM.GetStatutClass()">
                @VM.GetStatutLabel()
            </div>
        </div>

        <div class="progression-container">
            <div class="progression-bar">
                <div class="progression-step @(VM.Commande.IdEtatCommande >= 1 ? "completed" : "")">
                    <div class="step-circle">1</div>
                    <span class="step-label">Créée</span>
                </div>
                <div class="progression-line @(VM.Commande.IdEtatCommande >= 2 ? "completed" : "")"></div>

                <div class="progression-step @(VM.Commande.IdEtatCommande >= 2 ? "completed" : "")">
                    <div class="step-circle">2</div>
                    <span class="step-label">Paiement</span>
                </div>
                <div class="progression-line @(VM.Commande.IdEtatCommande >= 3 ? "completed" : "")"></div>

                <div class="progression-step @(VM.Commande.IdEtatCommande >= 3 ? "completed" : "")">
                    <div class="step-circle">3</div>
                    <span class="step-label">Validée</span>
                </div>

                <div class="progression-line @(VM.Commande.IdEtatCommande >= 4 ? "completed" : "")"></div>

                <div class="progression-step @(VM.Commande.IdEtatCommande >= 4 ? "completed" : "")">
                    <div class="step-circle">4</div>
                    <span class="step-label">Livraison</span>
                </div>

                <div class="progression-line @(VM.Commande.IdEtatCommande >= 5 ? "completed" : "")"></div>

                <div class="progression-step @(VM.Commande.IdEtatCommande >= 5 ? "completed" : "")">
                    <div class="step-circle">5</div>
                    <span class="step-label">Terminée</span>
                </div>
            </div>
        </div>

        <div class="commande-content">
            <div class="info-section">
                <h2>📋 Détails de la commande</h2>
                <div class="info-grid">
                    <div class="info-item">
                        <span class="info-label">Date</span>
                        <span class="info-value">@VM.Commande.Date.ToString("dd/MM/yyyy à HH:mm")</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Moyen de paiement</span>
                        <span class="info-value">@(VM.Commande.MoyenPaiement ?? "Non défini")</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Prix final</span>
                        <span class="info-value price-value">@(VM.PrixFinal.ToString("N0")) €</span>
                    </div>
                </div>
            </div>

            @if (VM.Commande.Annonce != null)
            {
                <div class="annonce-section">
                    <h2>🚗 Véhicule</h2>
                    <div class="annonce-card" @onclick='() => Navigation.NavigateTo($"/annonce/{VM.Commande.Annonce.IdAnnonce}")'>
                        <img src="@VM.GetAnnonceImage()" alt="@VM.Commande.Annonce.Libelle" class="annonce-image" />
                        <div class="annonce-info">
                            <h3>@VM.Commande.Annonce.Libelle</h3>
                            <div class="annonce-details">
                                <span>@VM.Commande.Annonce.Marque @VM.Commande.Annonce.Modele</span>
                                <span>@VM.Commande.Annonce.Annee</span>
                                <span>@(VM.Commande.Annonce.Kilometrage.ToString("N0")) km</span>
                                <span>@VM.Commande.Annonce.Carburant</span>
                            </div>
                            <div class="annonce-location">
                                📍 @VM.Commande.Annonce.Ville (@VM.Commande.Annonce.CodePostal)
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="parties-section">
                <div class="partie-card">
                    <h3>👤 Acheteur</h3>
                    <div class="partie-info">
                        <p class="partie-name">@(VM.Commande.PseudoAcheteur ?? "Inconnu")</p>
                        @if (VM.IsVendeur)
                        {
                            <button class="btn-contact-mini" @onclick="VM.ContacterAcheteur">
                                ✉️ Contacter
                            </button>
                        }
                        @if (VM.IsAcheteur)
                        {
                            <span class="badge-vous">Vous</span>
                        }
                    </div>
                </div>

                <div class="partie-card">
                    <h3>👤 Vendeur</h3>
                    <div class="partie-info">
                        <p class="partie-name">@(VM.Commande.PseudoVendeur ?? "Inconnu")</p>
                        @if (VM.IsAcheteur)
                        {
                            <button class="btn-contact-mini" @onclick="VM.ContacterVendeur">
                                ✉️ Contacter
                            </button>
                        }
                        @if (VM.IsVendeur)
                        {
                            <span class="badge-vous">Vous</span>
                        }
                    </div>
                </div>
            </div>

            @* État 1 : Acheteur doit payer *@
            @if (VM.IsAcheteur && VM.Commande.IdEtatCommande == 1)
            {
                <div class="action-section">
                    <h2>💳 Paiement</h2>
                    <div class="payment-choice">
                        <p class="payment-info">Choisissez votre mode de paiement pour finaliser l'achat :</p>

                        <button class="payment-option-card main-option" @onclick="VM.OpenPaiementModal">
                            <div class="payment-icon">💳</div>
                            <div class="payment-details">
                                <div class="payment-label">Carte bancaire</div>
                                <div class="payment-desc">Paiement sécurisé et validation immédiate</div>
                            </div>
                            <div class="payment-arrow">➔</div>
                        </button>

                        <div class="separator-text">Ou autres moyens (validation par le vendeur requise)</div>

                        <div class="other-payments-grid">
                            <button class="payment-option-mini" @onclick="() => VM.SelectAutrePaiement(2)" disabled="@VM.IsProcessingPayment">
                                <span class="icon">🏦</span> Virement Bancaire
                            </button>

                            <button class="payment-option-mini"
                                    @onclick="() => VM.SelectAutrePaiement(3)"
                                    disabled="@(VM.IsProcessingPayment || !VM.CanPayCash)"
                                    title="@(!VM.CanPayCash ? "Montant supérieur à 1000€" : "")">
                                <span class="icon">💵</span> Espèces
                                @if (!VM.CanPayCash)
                                {
                                    <span class="badge-limit">Non autorisé (>1000€)</span>
                                }
                            </button>

                            <button class="payment-option-mini" @onclick="() => VM.SelectAutrePaiement(4)" disabled="@VM.IsProcessingPayment">
                                <span class="icon">📝</span> Chèque de banque
                            </button>
                        </div>
                    </div>
                </div>
            }

            @* État 2 : Vendeur doit confirmer réception paiement *@
            @if (VM.IsVendeur && VM.Commande.IdEtatCommande == 2)
            {
                <div class="action-section">
                    <h2>⏳ Confirmation du paiement</h2>
                    <div class="info-box">
                        <p><strong>L'acheteur a indiqué avoir effectué un paiement par @(VM.Commande.MoyenPaiement ?? "un moyen non défini").</strong></p>
                        <p>
                            Vérifiez que vous avez bien reçu les fonds (sur votre compte, en main propre, etc.).
                            Confirmez ci-dessous uniquement lorsque vous êtes sûr.
                        </p>
                    </div>

                    <button class="btn-success btn-large" @onclick="VM.ConfirmPaymentReceived">
                        ✓ Confirmer la réception du paiement
                    </button>
                </div>
            }
            @if (VM.IsAcheteur && VM.Commande.IdEtatCommande == 2)
            {
                <div class="info-section waiting">
                    <h2>⏳ En attente</h2>
                    <p>Vous avez déclaré un paiement par <strong>@(VM.Commande.MoyenPaiement ?? "un moyen non défini")</strong>.</p>
                    <p>Le vendeur doit confirmer la réception pour poursuivre la transaction.</p>
                </div>
            }

            @* État 3 : Paiement validé -> Vendeur doit émettre livraison *@
            @if (VM.IsVendeur && VM.Commande.IdEtatCommande == 3)
            {
                <div class="action-section">
                    <h2>🚚 Livraison du véhicule</h2>
                    <div class="info-box success">
                        <p>✅ <strong>Le paiement a été confirmé !</strong></p>
                        <p>
                            Vous pouvez maintenant organiser la remise du véhicule avec l'acheteur.
                            Une fois que le véhicule est remis ou expédié, cliquez sur le bouton ci-dessous.
                        </p>
                    </div>

                    <button class="btn-primary btn-large" @onclick="VM.EmitDelivery">
                        🚀 Émettre la livraison / Remise
                    </button>
                </div>
            }
            @if (VM.IsAcheteur && VM.Commande.IdEtatCommande == 3)
            {
                <div class="info-section success">
                    <h2>✅ Paiement validé</h2>
                    <p>Le vendeur a confirmé la réception du paiement.</p>
                    <p>Il prépare actuellement la livraison du véhicule.</p>
                </div>
            }

            @* État 4 : Livraison émise, acheteur doit confirmer réception *@
            @if (VM.IsAcheteur && VM.Commande.IdEtatCommande == 4)
            {
                <div class="action-section">
                    <h2>📦 Réception du véhicule</h2>
                    <div class="info-box">
                        <p><strong>Le vendeur a indiqué que le véhicule a été remis ou expédié.</strong></p>
                        <p>
                            Une fois que vous avez récupéré le véhicule et que tout est en ordre,
                            confirmez ci-dessous pour finaliser la transaction.
                        </p>
                    </div>

                    <button class="btn-success btn-large" @onclick="VM.ConfirmVehicleReceived">
                        ✓ Confirmer la réception du véhicule
                    </button>
                </div>
            }
            @if (VM.IsVendeur && VM.Commande.IdEtatCommande == 4)
            {
                <div class="info-section waiting">
                    <h2>⏳ En attente de confirmation</h2>
                    <p>Vous avez émis la livraison.</p>
                    <p>L'acheteur doit maintenant confirmer qu'il a bien reçu le véhicule.</p>
                </div>
            }

            @* État 5 : Transaction terminée *@
            @if (VM.Commande.IdEtatCommande == 5)
            {
                <div class="success-section">
                    <div class="success-icon">🎉</div>
                    <h2>Transaction terminée !</h2>
                    @if (VM.IsAcheteur)
                    {
                        <p>
                            Félicitations pour votre achat !
                            Profitez bien de votre nouveau véhicule.
                        </p>
                    }
                    else if (VM.IsVendeur)
                    {
                        <p>
                            Félicitations !
                            Votre vente a été finalisée avec succès.
                        </p>
                    }
                    <div class="completed-badge">
                        ✅ Commande complétée
                    </div>
                </div>

                <div class="fin-actions-section">
                    <h3>Documents et Avis</h3>

                    <div class="actions-grid">

                        <div class="action-card">
                            <h4>📄 Facture</h4>
                            <p>Consultez ou téléchargez la facture.</p>

                            @if (!string.IsNullOrEmpty(VM.FactureErrorMessage))
                            {
                                <div class="alert alert-danger mb-3" style="font-size: 0.9rem;">
                                    @VM.FactureErrorMessage
                                </div>
                            }

                            @* --- NOUVEAUX BOUTONS VOIR / TÉLÉCHARGER --- *@
                            <div class="d-flex flex-wrap gap-2 justify-content-center mt-3">
                                <button class="btn btn-outline-primary flex-grow-1"
                                        @onclick="VM.VoirFacture"
                                        disabled="@VM.IsDownloadingFacture">
                                    @if (VM.IsDownloadingFacture)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span> <span>Chargement...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-eye me-1"></i> <span>Voir</span>
                                    }
                                </button>

                                <button class="btn btn-primary flex-grow-1"
                                        @onclick="VM.TelechargerFacture"
                                        disabled="@VM.IsDownloadingFacture">
                                    @if (VM.IsDownloadingFacture)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span> <span>Chargement...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-download me-1"></i> <span>Télécharger</span>
                                    }
                                </button>
                            </div>
                        </div>

                        <div class="action-card avis-card">
                            <h4>⭐ Laisser un avis</h4>
                            @if (!VM.AvisEnvoye)
                            {
                                <p>Notez votre expérience avec @(VM.IsAcheteur ? "le vendeur" : "l'acheteur").</p>

                                <div class="rating-stars">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        int starValue = i;
                                        <span class="star @(starValue <= VM.NoteAvis ? "filled" : "")"
                                              @onclick="() => VM.NoteAvis = starValue">★</span>
                                    }
                                </div>

                                <textarea class="form-input avis-textarea"
                                          placeholder="Racontez votre expérience..."
                                          @bind="VM.ContenuAvis"></textarea>

                                <button class="btn-primary" @onclick="VM.EnvoyerAvis" disabled="@VM.IsSendingAvis">
                                    @if (VM.IsSendingAvis)
                                    {
                                        <span>Envoi...</span>
                                    }
                                    else
                                    {
                                        <span>Envoyer mon avis</span>
                                    }
                                </button>
                            }
                            else
                            {
                                <div class="avis-envoye-msg">
                                    <span class="check-icon">✓</span>
                                    <p>Merci ! Votre avis a bien été envoyé.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int IdCommande { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await VM.InitializeAsync(IdCommande, StateHasChanged, Navigation);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await VM.CleanupAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur dispose: {ex.Message}");
        }
    }
}