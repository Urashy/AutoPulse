@page "/vente"
@using BlazorAutoPulse.ViewModel
@using AutoPulse.Shared.DTO.Immat
@inject VenteViewModel VM
@inject GetAllViewModel VMAll
@inject NavigationManager nav

<PageTitle>AutoPulse - Vendre</PageTitle>

@* Composant Modal Paiement *@
<PaiementModal IsVisible="@VM.showPaiementMavModal"
               IdCb="@((int value) => VM.SetIdCb(value))"
               Id="@VM.annonce.IdMiseEnAvant"
               Type="vente"
               IsVisibleChanged="@((bool value) => VM.showPaiementMavModal = value)"
               OnPaymentSuccess="@VM.OnPaymentSuccess" />

@* Composant Modal Immatriculation *@
<ImmatModal IsVisible="@VM.showImmatModal"
            IsVisibleChanged="@((bool value) => VM.showImmatModal = value)"
            OnApplyData="@VM.HandleImmatDataApplied" />

@* Overlay pour fermer le dropdown *@
@if (VM.dropdownOpen)
{
    <div @onclick="VM.CloseDropdown" style="position:fixed;top:0;left:0;width:100%;height:100%;z-index:998;background:transparent;"></div>
}

@* POPUPS IA *@
@* Popup Warning CNN *@
@if (VM.showCnnWarningPopup)
{
    <div class="popup-overlay">
        <div class="popup-container">
            <div class="popup-header">
                <h3>⚠️ Reconnaissance par IA</h3>
            </div>
            <div class="popup-content">
                <p>Le dataset utilisé pour l'entraînement est limité, l'IA peut faire des erreurs sur les véhicules courants.</p>
                <p><strong>Voulez-vous continuer ?</strong></p>
            </div>
            <div class="popup-actions">
                <button class="btn-cancel" @onclick="VM.CloseCnnWarningPopup">Annuler</button>
                <button class="btn-confirm" @onclick="VM.ExecuteCnnRecognition">Continuer</button>
            </div>
        </div>
    </div>
}

@* Popup Loading CNN *@
@if (VM.showCnnLoadingPopup)
{
    <div class="popup-overlay">
        <div class="popup-container popup-loading">
            <div class="loading-spinner"></div>
            <p>Analyse de l'image en cours...</p>
        </div>
    </div>
}

@* Popup Résultat CNN *@
@if (VM.showCnnResultPopup && VM.cnnResult != null)
{
    <div class="popup-overlay">
        <div class="popup-container">
            <div class="popup-header">
                <h3>🎯 Résultat de la reconnaissance</h3>
            </div>
            <div class="popup-content">
                <div class="ia-result-box">
                    <p><strong>Marque détectée :</strong> @VM.cnnResult.Manufacturer</p>
                    <p><strong>Modèle détecté :</strong> @VM.cnnResult.Model</p>
                    <p><strong>Confiance :</strong> @VM.cnnResult.Confidence</p>

                    @if (VM.cnnResult.TopPredictions?.Any() == true)
                    {
                        <div class="top-predictions">
                            <p><strong>Autres prédictions :</strong></p>
                            @foreach (var pred in VM.cnnResult.TopPredictions.Skip(1).Take(3))
                            {
                                <p class="alt-pred">• @pred.Manufacturer @pred.Model (@pred.Confidence)</p>
                            }
                        </div>
                    }
                </div>
                <p class="popup-question">Voulez-vous pré-remplir ces champs ?</p>
            </div>
            <div class="popup-actions">
                <button class="btn-cancel" @onclick="VM.CancelCnnResult">Non</button>
                <button class="btn-confirm" @onclick="async () => await VM.ApplyCnnResult()">Oui, pré-remplir</button>
            </div>
        </div>
    </div>
}

@* Popup Warning Prix *@
@if (VM.showPriceWarningPopup)
{
    <div class="popup-overlay">
        <div class="popup-container">
            <div class="popup-header">
                <h3>⚠️ Champs manquants</h3>
            </div>
            <div class="popup-content">
                <p>Les champs suivants ne sont pas remplis :</p>
                <ul class="missing-fields-list">
                    @foreach (var field in VM.missingFields)
                    {
                        <li>• @field</li>
                    }
                </ul>
                <p><strong>L'IA risque d'être moins précise. Voulez-vous continuer ?</strong></p>
            </div>
            <div class="popup-actions">
                <button class="btn-cancel" @onclick="VM.ClosePriceWarningPopup">Annuler</button>
                <button class="btn-confirm" @onclick="VM.ExecutePricePrediction">Continuer quand même</button>
            </div>
        </div>
    </div>
}

@* Popup Loading Prix *@
@if (VM.showPriceLoadingPopup)
{
    <div class="popup-overlay">
        <div class="popup-container popup-loading">
            <div class="loading-spinner"></div>
            <p>Prédiction du prix en cours...</p>
        </div>
    </div>
}

@* Popup Warning Ajustement *@
@if (VM.showAdjustmentWarningPopup)
{
    <div class="popup-overlay">
        <div class="popup-container">
            <div class="popup-header">
                <h3>⚠️ Ajustement par IA</h3>
            </div>
            <div class="popup-content">
                <p>L'IA va analyser votre description pour détecter d'éventuels défauts et ajuster le prix en conséquence.</p>
                <p><strong>⚠️ Attention :</strong> L'IA peut faire des erreurs, vérifiez bien le résultat avant de l'appliquer.</p>
            </div>
            <div class="popup-actions">
                <button class="btn-cancel" @onclick="VM.CloseAdjustmentWarningPopup">Annuler</button>
                <button class="btn-confirm" @onclick="VM.ExecuteAdjustment">Analyser</button>
            </div>
        </div>
    </div>
}

@* Popup Loading Ajustement *@
@if (VM.showAdjustmentLoadingPopup)
{
    <div class="popup-overlay">
        <div class="popup-container popup-loading">
            <div class="loading-spinner"></div>
            <p>Analyse de la description en cours...</p>
        </div>
    </div>
}

@* Popup Résultat Ajustement *@
@if (VM.showAdjustmentResultPopup && VM.adjustmentResult != null)
{
    <div class="popup-overlay">
        <div class="popup-container popup-large">
            <div class="popup-header">
                <h3>📊 Résultat de l'analyse</h3>
            </div>
            <div class="popup-content">
                <div class="adjustment-result">
                    <div class="adjustment-category">
                        <strong>Catégorie :</strong> @VM.adjustmentResult.Category
                    </div>

                    <div class="price-comparison">
                        <div class="price-item">
                            <span class="price-label">Prix initial</span>
                            <span class="price-value">@VM.adjustmentResult.BasePrice.ToString("N0") €</span>
                        </div>
                        <div class="price-arrow">→</div>
                        <div class="price-item">
                            <span class="price-label">Prix ajusté</span>
                            <span class="price-value adjusted">@VM.adjustmentResult.AdjustedPrice.ToString("N0") €</span>
                        </div>
                    </div>

                    <div class="reduction-info">
                        <p><strong>Réduction :</strong> @VM.adjustmentResult.ReductionAmount.ToString("N0") € (-@VM.adjustmentResult.ReductionPercent.ToString("N2")%)</p>
                        <p><strong>Coefficient de qualité :</strong> @VM.adjustmentResult.QualityCoefficient.ToString("N2")</p>
                    </div>

                    <div class="description-analyzed">
                        <p><strong>Description analysée :</strong></p>
                        <p class="description-text">@VM.adjustmentResult.DescriptionAnalyzed</p>
                    </div>
                </div>
            </div>
            <div class="popup-actions">
                <button class="btn-confirm" @onclick="VM.AcceptPriceAdjustment">Accepter le nouveaux prix</button>
                <button class="btn-confirm" @onclick="VM.CloseAdjustmentResultPopup">OK</button>
            </div>
        </div>
    </div>
}

<div id="sell" class="page active">
    <div class="sell-container">
        <div class="sell-header-with-immat">
            <h2 class="section-title">Vendez Votre Voiture</h2>

            @* NOUVEAU BOUTON IMMATRICULATION *@
            <button type="button" class="btn-immat-trigger" @onclick="VM.OpenImmatModal">
                <span class="immat-icon">🚗</span>
                <span class="immat-text">Recherche par plaque</span>
            </button>
        </div>

        <div class="sell-form">
            <form>
                <h3 style="margin-bottom: 30px; color: #00d4ff;">Informations du véhicule</h3>

                @if (VM.showErrors && VM.errors.ContainsKey("general"))
                {
                    <div class="error-message-global">
                        @VM.GetError("general")
                    </div>
                }

                <div class="form-group @(VM.HasError("titre") ? "has-error" : "")">
                    <label>Titre</label>
                    <input type="text" placeholder="Titre de votre annonce" @bind="VM.annonce.Libelle" required/>
                    @if (VM.HasError("titre"))
                    {
                        <span class="error-message">@VM.GetError("titre")</span>
                    }
                </div>

                <div class="form-group @(VM.HasError("photos") ? "has-error" : "")">
                    <label>Photos du véhicule (ajouter la première sera la photo de couverture puis ajouter les autres, 10 images de 10 mb max)</label>

                    @if (!VM.imageUpload.Any())
                    {
                        <label for="vehiclePhotos" class="file-upload" style="cursor: pointer; display: block; border: 2px dashed #ccc; padding: 20px; text-align: center;">
                            <div style="font-size: 48px; margin-bottom: 20px;">📸</div>
                            <p style="color: #aaa;">Cliquez pour la photo de couverture</p>
                            <p style="color: #666; font-size: 14px; margin-top: 10px;">JPG, PNG - Max 10 photos</p>
                        </label>
                        <InputFile id="vehiclePhotos" OnChange="@VM.UploadImage" multiple style="display:none"/>
                    }
                    else
                    {
                        <!-- Carrousel d'images -->
                        <div class="images-carousel-section">
                            <!-- Image principale -->
                            <div class="main-image-carousel">
                                @if (!string.IsNullOrEmpty(VM.GetCurrentImageUrl()))
                                {
                                    <img src="@VM.GetCurrentImageUrl()" alt="Photo @(VM.CurrentImageIndex + 1)" />

                                    <!-- Bouton supprimer sur l'image -->
                                    <button type="button"
                                            class="btn-delete-image"
                                            @onclick="VM.RemoveCurrentImage"
                                            title="Supprimer cette photo">
                                        🗑️
                                    </button>

                                    <!-- Badge numéro de photo -->
                                    <div class="image-badge">
                                        Photo @(VM.CurrentImageIndex + 1) / @VM.imageUpload.Count
                                        @if (VM.CurrentImageIndex == 0)
                                        {
                                            <span class="cover-badge">📌 Couverture</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <!-- Indicateur de chargement -->
                                    <div class="image-loading">
                                        <div class="spinner-image"></div>
                                        <p>Chargement de l'image @(VM.CurrentImageIndex + 1)...</p>
                                    </div>
                                }
                            </div>

                            <!-- Navigation -->
                            @if (VM.imageUpload.Count > 1)
                            {
                                <div class="image-navigation-carousel">
                                    <button type="button"
                                            @onclick="VM.PreviousImage"
                                            class="nav-btn"
                                            disabled="@(!VM.CanGoPrevious)">
                                        ◀
                                    </button>
                                    <div class="image-counter">
                                        @(VM.CurrentImageIndex + 1) / @VM.imageUpload.Count
                                    </div>
                                    <button type="button"
                                            @onclick="VM.NextImage"
                                            class="nav-btn"
                                            disabled="@(!VM.CanGoNext)">
                                        ▶
                                    </button>
                                </div>

                                <!-- Miniatures -->
                                <div class="thumbnails-carousel">
                                    @for (int i = 0; i < VM.imageUpload.Count; i++)
                                    {
                                        var index = i;
                                        var thumbnailUrl = VM.GetThumbnailUrl(index);

                                        <div class="thumbnail-carousel @(index == VM.CurrentImageIndex ? "active" : "") @(string.IsNullOrEmpty(thumbnailUrl) ? "loading" : "")"
                                             @onclick="() => VM.SelectImage(index)">

                                            @if (!string.IsNullOrEmpty(thumbnailUrl))
                                            {
                                                <img src="@thumbnailUrl" alt="Miniature @(index + 1)" />

                                                @if (index == 0)
                                                {
                                                    <div class="thumbnail-cover-indicator">📌</div>
                                                }

                                                <button type="button"
                                                        class="btn-delete-thumbnail"
                                                        @onclick="() => VM.RemoveImage(index)"
                                                        @onclick:stopPropagation="true"
                                                        title="Supprimer">
                                                    ✕
                                                </button>
                                            }
                                            else
                                            {
                                                <div class="thumbnail-loading">
                                                    <div class="spinner-thumbnail"></div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            <!-- Bouton ajouter plus de photos -->
                            <label for="vehiclePhotos" class="btn-add-more-photos">
                                <span class="add-icon">➕</span>
                                Ajouter d'autres photos (@VM.imageUpload.Count / 10)
                            </label>
                            <InputFile id="vehiclePhotos" OnChange="@VM.UploadImage" multiple style="display:none"/>
                        </div>
                    }

                    @if (VM.HasError("photos"))
                    {
                        <span class="error-message">@VM.GetError("photos")</span>
                    }
                </div>


                @* BOUTON IA CNN *@
                <button type="button"
                        class="btn-ia btn-ia-cnn"
                        disabled="@(!VM.CanUseCnn)"
                        @onclick="VM.OpenCnnWarningPopup">
                    🤖 Pré-remplir "marque" et "modèle" avec l'IA
                </button>

                <div class="form-row">
                    <div class="form-group @(VM.HasError("marque") ? "has-error" : "")">
                        <label>Marque</label>
                        <select @bind="VM.selectedMarqueId">
                            <option value="0">Toutes les marques</option>
                            @if (VMAll.allMarques != null)
                            {
                                @foreach (var marque in VMAll.allMarques)
                                {
                                    <option value="@marque.IdMarque">@marque.LibelleMarque</option>
                                }
                            }
                        </select>
                        @if (VM.HasError("marque"))
                        {
                            <span class="error-message">@VM.GetError("marque")</span>
                        }
                    </div>
                    <div class="form-group @(VM.HasError("modele") ? "has-error" : "")">
                        <label>Modèle</label>
                        <select @bind="VM.selectedModeleId">
                            <option value="0">Tous les modèles</option>
                            @if (VMAll.filteredModeles != null)
                            {
                                @foreach (var modele in VMAll.filteredModeles)
                                {
                                    <option value="@modele.IdModele">@modele.LibelleModele</option>
                                }
                            }
                        </select>
                        @if (VM.HasError("modele"))
                        {
                            <span class="error-message">@VM.GetError("modele")</span>
                        }
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group @(VM.HasError("annee") ? "has-error" : "")">
                        <label>Année</label>
                        <input type="number" placeholder="2021" required @bind="VM.VoitureDetailDto.Annee">
                        @if (VM.HasError("annee"))
                        {
                            <span class="error-message">@VM.GetError("annee")</span>
                        }
                    </div>
                    <div class="form-group @(VM.HasError("kilometrage") ? "has-error" : "")">
                        <label>Kilométrage</label>
                        <input type="number" placeholder="45000" required @bind="VM.VoitureDetailDto.Kilometrage">
                        @if (VM.HasError("kilometrage"))
                        {
                            <span class="error-message">@VM.GetError("kilometrage")</span>
                        }
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group @(VM.HasError("puissance") ? "has-error" : "")">
                        <label>Nombre de chevaux</label>
                        <input type="number" placeholder="100" required @bind="VM.VoitureDetailDto.Puissance">
                        @if (VM.HasError("puissance"))
                        {
                            <span class="error-message">@VM.GetError("puissance")</span>
                        }
                    </div>
                    <div class="form-group @(VM.HasError("couple") ? "has-error" : "")">
                        <label>Couple</label>
                        <input type="number" placeholder="100" required @bind="VM.VoitureDetailDto.Couple">
                        @if (VM.HasError("couple"))
                        {
                            <span class="error-message">@VM.GetError("couple")</span>
                        }
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group @(VM.HasError("carburant") ? "has-error" : "")">
                        <label>Carburant</label>
                        <select @bind="VM.selectedCarburantId">
                            <option value="0">Tous les carburants</option>
                            @if (VMAll.allCarburants != null)
                            {
                                @foreach (var carburant in VMAll.allCarburants)
                                {
                                    <option value="@carburant.IdCarburant">@carburant.LibelleCarburant</option>
                                }
                            }
                        </select>
                        @if (VM.HasError("carburant"))
                        {
                            <span class="error-message">@VM.GetError("carburant")</span>
                        }
                    </div>
                    <div class="form-group @(VM.HasError("motricite") ? "has-error" : "")">
                        <label>Motricité</label>
                        <select @bind="VM.selectedMotriciteId">
                            <option value="0">Toutes les motricités</option>
                            @if (VMAll.allMotricite != null)
                            {
                                @foreach (var motricite in VMAll.allMotricite)
                                {
                                    <option value="@motricite.IdMotricite">@motricite.LibelleMotricite</option>
                                }
                            }
                        </select>
                        @if (VM.HasError("motricite"))
                        {
                            <span class="error-message">@VM.GetError("motricite")</span>
                        }
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group @(VM.HasError("nbporte") ? "has-error" : "")">
                        <label>Nombre de portes</label>
                        <input type="number" placeholder="5" @bind="VM.VoitureDetailDto.NbPorte" required>
                        @if (VM.HasError("nbporte"))
                        {
                            <span class="error-message">@VM.GetError("nbporte")</span>
                        }
                    </div>
                    <div class="form-group @(VM.HasError("nbplace") ? "has-error" : "")">
                        <label>Nombre de places</label>
                        <input type="number" placeholder="5" @bind="VM.VoitureDetailDto.NbPlace" required>
                        @if (VM.HasError("nbplace"))
                        {
                            <span class="error-message">@VM.GetError("nbplace")</span>
                        }
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group @(VM.HasError("nbcylindres") ? "has-error" : "")">
                        <label>Nombre de cylindres</label>
                        <input type="number" placeholder="4" @bind="VM.VoitureDetailDto.NbCylindres" disabled="@(VM.VoitureDetailDto.IdCarburant == 4)" required>
                        @if (VM.HasError("nbcylindres"))
                        {
                            <span class="error-message">@VM.GetError("nbcylindres")</span>
                        }
                    </div>
                    <div class="form-group">
                        <label>Date de mise en circulation</label>
                        <input type="date" placeholder="2000-01-01" @bind="VM.VoitureDetailDto.MiseEnCirculation" required>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group @(VM.HasError("boitedevitesse") ? "has-error" : "")">
                        <label>Boîte de vitesse</label>
                        <select @bind="@VM.selectedBoiteId" disabled="@(VM.VoitureDetailDto.IdCarburant == 4)">
                            @if (VM.VoitureDetailDto.IdCarburant == 4)
                            {
                                <option value="2">Automatique</option>
                            }
                            else
                            {
                                <option value="0">Toutes les boîtes de vitesse</option>
                                @if (VMAll.allBoiteDeVitesse != null)
                                {
                                    @foreach (var boite in VMAll.allBoiteDeVitesse)
                                    {
                                        <option value="@boite.IdBoiteDeVitesse">@boite.LibelleBoite</option>
                                    }
                                }
                            }
                        </select>
                        @if (VM.HasError("boitedevitesse"))
                        {
                            <span class="error-message">@VM.GetError("boitedevitesse")</span>
                        }
                    </div>
                    <div class="form-group @(VM.HasError("categorie") ? "has-error" : "")">
                        <label>Catégorie de ma voiture</label>
                        <select @bind="VM.selectedCategorieId">
                            <option value="0">Toutes les catégories</option>
                            @if (VMAll.allCategories != null)
                            {
                                @foreach (var categorie in VMAll.allCategories)
                                {
                                    <option value="@categorie.IdCategorie">@categorie.LibelleCategorie</option>
                                }
                            }
                        </select>
                        @if (VM.HasError("categorie"))
                        {
                            <span class="error-message">@VM.GetError("categorie")</span>
                        }
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group @(VM.HasError("cylindrermoteur") ? "has-error" : "")">
                        <label>Cylindrée du moteur (L)</label>
                        <input type="number"
                               step="0.1"
                               placeholder="2.0"
                               @bind="VM.VoitureDetailDto.CylindrerMoteur"
                               disabled="@(VM.VoitureDetailDto.IdCarburant == 4)"
                               required>
                        @if (VM.HasError("cylindrermoteur"))
                        {
                            <span class="error-message">@VM.GetError("cylindrermoteur")</span>
                        }
                    </div>
                    <div class="form-group @(VM.HasError("positionvolant") ? "has-error" : "")">
                        <label>Position du volant</label>
                        <select @onchange="VM.OnPositionVolantChange">
                            <option value="">Sélectionnez une position</option>
                            <option value="true" selected="@(VM.VoitureDetailDto.PositionVolant == true)">Gauche</option>
                            <option value="false" selected="@(VM.VoitureDetailDto.PositionVolant == false)">Droite</option>
                        </select>
                        @if (VM.HasError("positionvolant"))
                        {
                            <span class="error-message">@VM.GetError("positionvolant")</span>
                        }
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Nombre d'airbag</label>
                        <input type="number" placeholder="Par défaut : 4" @bind="VM.VoitureDetailDto.NbAirbag" required>
                    </div>
                    <label class="custom-checkbox-wrapper">
                        <input type="checkbox"
                               class="custom-checkbox-input"
                               @bind="VM.VoitureDetailDto.InterieurCuire">
                        <span class="custom-checkbox-label">Intérieur en cuir</span>
                    </label>
                </div>

                <div class="form-row">
                    <div class="form-group @(VM.HasError("prix") ? "has-error" : "")">
                        <label>Prix souhaité (€)</label>
                        <input type="number" placeholder="25000" @bind="VM.annonce.Prix" required>
                        @if (VM.HasError("prix"))
                        {
                            <span class="error-message">@VM.GetError("prix")</span>
                        }

                        @* BOUTON IA PRÉDICTION PRIX *@
                        <button type="button" class="btn-ia" @onclick="VM.CheckAndPredictPrice">
                            ✨ Estimer le prix par l'IA
                        </button>

                        @* AFFICHAGE PRIX PRÉDIT *@
                        @if (VM.priceResult != null && VM.priceResult.Success)
                        {
                            <div class="ia-price-result" @onclick="@VM.AcceptPredictPrice">
                                <label>Prix estimé par l'IA (cliquer pour remplir le prix)</label>
                                <div class="predicted-price">
                                    @VM.priceResult.PredictedPrice.ToString("N0") @VM.priceResult.Currency
                                    <span class="confidence-badge">Confiance: @((VM.priceResult.ConfidenceScore * 100).ToString("N0"))%</span>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="form-group @(VM.HasError("couleurs") ? "has-error" : "")">
                        <label>Couleurs</label>
                        <div class="multiselect-dropdown" style="position:relative;">
                            <div class="select-box" @onclick="VM.ToggleDropdown">
                                @if (VM.selectedCouleurs.Any())
                                {
                                    <span>@string.Join(", ", VM.selectedCouleurs.Select(id => VMAll.allCouleurs.First(c => c.IdCouleur == id).LibelleCouleur))</span>
                                }
                                else
                                {
                                    <span>Sélectionnez des couleurs</span>
                                }
                                <span class="arrow">&#9662;</span>
                            </div>

                            @if (VM.dropdownOpen)
                            {
                                <div class="options" @onmouseleave="VM.ToggleDropdown" style="position:absolute;z-index:999;background:white;border:1px solid #ccc;width:100%;max-height:200px;overflow-y:auto;">
                                    @if (VMAll.allCouleurs != null)
                                    {
                                        @foreach (var couleur in VMAll.allCouleurs)
                                        {
                                            <div class="couleur-option"
                                                 @onclick="() => VM.ToggleCouleur(couleur.IdCouleur)"
                                                 @onclick:stopPropagation="true">
                                                <input type="checkbox"
                                                       checked="@VM.selectedCouleurs.Contains(couleur.IdCouleur)"
                                                       style="pointer-events:none;margin:0;" />
                                                <span>@couleur.LibelleCouleur</span>
                                                <div class="color-square" style="background-color: @couleur.CodeHexaCouleur"></div>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </div>
                        @if (VM.HasError("couleurs"))
                        {
                            <span class="error-message">@VM.GetError("couleurs")</span>
                        }
                    </div>
                </div>

                <h3 style="margin-top: 40px; margin-bottom: 30px; color: #00d4ff;">Adresse de vente</h3>

                <div class="address-section">
                    <div class="saved-addresses-sidebar">
                        <div class="saved-addresses-label">Adresses enregistrées</div>
                        <div class="address-quick-button reset @(VM.selectedAddressId == null ? "active" : "")" @onclick="VM.ResetAddress">
                            <span class="address-btn-name">
                                <span class="reset-icon">🔄</span>
                                Nouvelle adresse
                            </span>
                            <div class="address-btn-location">Vider les champs</div>
                        </div>

                        @if (VM.compteAdresses != null && VM.compteAdresses.Any())
                        {
                            @foreach (var addr in VM.compteAdresses)
                            {
                                <div class="address-quick-button @(VM.selectedAddressId == addr.IdAdresse ? "active" : "")"
                                     @onclick="() => VM.LoadAddress(addr)">
                                    <span class="address-btn-name">@addr.Nom</span>
                                    <div class="address-btn-location">@addr.CodePostal @addr.LibelleVille</div>
                                </div>
                            }
                        }
                    </div>

                    <div class="address-form-fields">
                        @* NOUVEAU: Champ de recherche d'adresse avec autocomplétion *@
                        <div class="form-group address-search-container">
                            <label>Rechercher une adresse</label>
                            <div style="position: relative;">
                                <input type="text"
                                       placeholder="Ex: 1 Rue de la République, 75001 Paris..."
                                       value="@VM.searchQuery"
                                       @oninput="@(async (ChangeEventArgs e) => await VM.OnSearchQueryChanged(e.Value?.ToString() ?? ""))"
                                       class="address-search-input"
                                       autocomplete="off" />

                                @if (VM.isSearchingAddress)
                                {
                                    <div class="address-search-loader">
                                        <span class="spinner-small"></span>
                                    </div>
                                }

                                @if (VM.showAddressSuggestions && VM.addressSuggestions.Any())
                                {
                                    <div class="address-suggestions-dropdown">
                                        @foreach (var suggestion in VM.addressSuggestions)
                                        {
                                            <div class="address-suggestion-item"
                                                 @onclick="() => VM.SelectAddressSuggestion(suggestion)"
                                                 @onclick:stopPropagation="true">
                                                <div class="suggestion-icon">📍</div>
                                                <div class="suggestion-text">
                                                    <div class="suggestion-main">@suggestion.DisplayName</div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <small style="color: #888; margin-top: 5px; display: block;">
                                Commencez à taper pour rechercher une adresse (minimum 3 caractères)
                            </small>
                        </div>

                        <div class="form-group @(VM.HasError("nomadresse") ? "has-error" : "")">
                            <label>Nom de l'adresse</label>
                            <input type="text" placeholder="Ex: Domicile, Bureau, Garage..." @bind="VM.adresse.Nom" disabled="@(VM.selectedAddressId != null ? "disabled" : null)" required>
                            @if (VM.HasError("nomadresse"))
                            {
                                <span class="error-message">@VM.GetError("nomadresse")</span>
                            }
                        </div>

                        <div class="form-row">
                            <div class="form-group @(VM.HasError("numeroadresse") ? "has-error" : "")">
                                <label>Numéro de rue</label>
                                <input type="number" placeholder="12" @bind="VM.adresse.Numero" disabled="@(VM.selectedAddressId != null ? "disabled" : null)" required>
                                @if (VM.HasError("numeroadresse"))
                                {
                                    <span class="error-message">@VM.GetError("numeroadresse")</span>
                                }
                            </div>
                            <div class="form-group @(VM.HasError("rueadresse") ? "has-error" : "")">
                                <label>Rue</label>
                                <input type="text" placeholder="Rue de..." @bind="VM.adresse.Rue" disabled="@(VM.selectedAddressId != null ? "disabled" : null)" required>
                                @if (VM.HasError("rueadresse"))
                                {
                                    <span class="error-message">@VM.GetError("rueadresse")</span>
                                }
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group @(VM.HasError("codepostal") ? "has-error" : "")">
                                <label>Code postal</label>
                                <input type="text" placeholder="75001" @bind="VM.adresse.CodePostal" disabled="@(VM.selectedAddressId != null ? "disabled" : null)" required>
                                @if (VM.HasError("codepostal"))
                                {
                                    <span class="error-message">@VM.GetError("codepostal")</span>
                                }
                            </div>
                            <div class="form-group @(VM.HasError("ville") ? "has-error" : "")">
                                <label>Ville</label>
                                <input type="text" placeholder="Paris" @bind="VM.adresse.LibelleVille" disabled="@(VM.selectedAddressId != null ? "disabled" : null)" required>
                                @if (VM.HasError("ville"))
                                {
                                    <span class="error-message">@VM.GetError("ville")</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                @* Overlay pour fermer les suggestions quand on clique à l'extérieur *@
                @if (VM.showAddressSuggestions)
                {
                    <div @onclick="VM.CloseAddressSuggestions"
                         style="position:fixed;top:0;left:0;width:100%;height:100%;z-index:998;background:transparent;"></div>
                }

                <div class="form-group">
                    <label>Description</label>
                    <textarea placeholder="Décrivez votre véhicule, son état, ses équipements..." @bind="VM.annonce.Description"></textarea>

                    @* BOUTON IA AJUSTEMENT *@
                    <button type="button"
                            class="btn-ia btn-ia-adjustment"
                            disabled="@(!VM.CanUseAdjustment)"
                            @onclick="VM.OpenAdjustmentWarningPopup">
                        🔍 Analyser la description et ajuster le prix
                    </button>
                </div>

                <div class="form-group  @(VM.HasError("couleurs") ? "has-error" : "")">
                    <label>Mise en avant</label>
                    <select @onchange="@VM.OnMiseEnAvantChange">
                        <option value="0">Toutes les mise en avant</option>
                        @if (VMAll.allMiseEnAvant != null)
                        {
                            @foreach (var miseEnAvant in VMAll.allMiseEnAvant)
                            {
                                <option value="@miseEnAvant.IdMiseEnAvant">@miseEnAvant.LibelleMiseEnAvant (@miseEnAvant.PrixSemaine€)</option>
                            }
                        }
                    </select>
                    @if (VM.HasError("miseEnAvant"))
                    {
                        <span class="error-message">@VM.GetError("miseEnAvant")</span>
                    }
                </div>

                <button @onclick="@VM.CreateAnnonceOrPayMav" type="button" class="btn-submit" style="margin-top: 20px;">Publier mon annonce</button>
            </form>
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await VMAll.InitializeAsync();
        await VM.InitializeAsync(StateHasChanged, nav, VMAll);
    }
}
