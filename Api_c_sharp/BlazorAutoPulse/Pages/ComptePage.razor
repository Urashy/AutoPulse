@page "/compte"
@using BlazorAutoPulse.ViewModel
@inject NavigationManager Navigation
@inject CompteViewModel VM
@inject ConnexionViewModel ConnexionVM

<PageTitle>Mon Compte - AutoPulse</PageTitle>

<AdresseModal IsVisible="@VM.showAdresseModal"
              IsEditMode="@VM.isEditingAdresse"
              EditAdresse="@VM.selectedAdresseToEdit"
              IsVisibleChanged="@((bool value) => VM.showAdresseModal = value)"
              OnAdresseSaved="@VM.OnAdresseSaved" />

<CarteBancaireModal IsVisible="@VM.showCarteModal"
                    IsVisibleChanged="@((bool value) => VM.showCarteModal = value)"
                    OnCarteSaved="@VM.OnCarteSaved" />

<!-- Modal suppression de compte -->
@if (VM.modalSuppression)
{
    <div class="modal-overlay" @onclick="VM.CloseSuppressionModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>⚠️ Suppression du compte</h3>
                <button class="modal-close" @onclick="VM.CloseSuppressionModal">✕</button>
            </div>

            <div class="modal-body">
                @if (!VM.confirmationSuppression)
                {
                    <!-- Étape 1 : Saisie du mot de confirmation -->
                    <div class="warning-box">
                        <p class="warning-text">
                            Pour confirmer la suppression de votre compte, veuillez entrer le mot <strong>@VM.compte.Pseudo</strong> ci-dessous.
                        </p>
                    </div>

                    <div class="form-group">
                        <input type="text"
                               placeholder="SUPPRIMER"
                               @bind="VM.confirmationTexte"
                               class="info-input">
                    </div>
                    <button class="btn-danger-full" @onclick="VM.ContinuerSuppression">
                        Continuer
                    </button>
                }
                else
                {
                    if (!VM.suppressionReussi)
                    {
                        <!-- Étape 2 : Confirmation finale -->
                        <div class="danger-box">
                            <div class="danger-icon">❗</div>
                            <h4>Attention : Cette action est définitive !</h4>
                            <p class="final-warning">
                                Cette action ne peut pas être annulée. Êtes-vous absolument certain(e) de vouloir continuer ?
                            </p>
                            <button class="btn-secondary" @onclick="VM.CloseSuppressionModal">
                                Annuler
                            </button>
                            <button class="btn-danger-full" @onclick="VM.ConfirmDeleteAccount">
                                Confirmer la suppression
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="success-box">
                            <h4>✓Compte supprimé avec succès</h4>
                            <p class="success-message">
                                Votre compte a été définitivement supprimé.
                            </p>
                            <p class="redirect-message">
                                Vous allez être redirigé vers la page d'accueil dans <strong>1</strong> secondes)
                            </p>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

<!-- Modal changement de mot de passe -->
@if (VM.showPasswordModal)
{
    <div class="modal-overlay" @onclick="VM.ClosePasswordModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Changer le mot de passe</h3>
                <button class="modal-close" @onclick="VM.ClosePasswordModal">✕</button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(VM.passwordError))
                {
                    <div class="error-message-box">
                        @VM.passwordError
                    </div>
                }

                @if (!string.IsNullOrEmpty(VM.passwordSuccess))
                {
                    <div class="success-message-box">
                        ✓ @VM.passwordSuccess
                    </div>
                }

                <form>
                    <div class="form-group @(!VM.currentPasswordValid ? "has-error" : "")">
                        <label>Mot de passe actuel</label>
                        <input type="password"
                               placeholder="••••••••"
                               @bind="VM.currentPassword"
                               disabled="@VM.isChangingPassword"
                               required>
                    </div>

                    <div class="form-group @(!VM.newPasswordValid ? "has-error" : "")">
                        <label>Nouveau mot de passe</label>
                        <input type="password"
                               placeholder="••••••••"
                               @bind="VM.newPassword"
                               disabled="@VM.isChangingPassword"
                               required>
                    </div>

                    <div class="form-group @(!VM.newPasswordValid ? "has-error" : "")">
                        <label>Confirmer le nouveau mot de passe</label>
                        <input type="password"
                               placeholder="••••••••"
                               @bind="VM.confirmNewPassword"
                               disabled="@VM.isChangingPassword"
                               required>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button class="btn-secondary" @onclick="VM.ClosePasswordModal" disabled="@VM.isChangingPassword">
                    Annuler
                </button>
                <button class="btn-primary" @onclick="VM.ChangePassword" disabled="@VM.isChangingPassword">
                    @if (VM.isChangingPassword)
                    {
                        <span>Modification...</span>
                    }
                    else
                    {
                        <span>Valider</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Modal passer en compte professionnel -->
@if (VM.passerPro)
{
    <div class="modal-overlay" @onclick="VM.CloseProModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>💼 Passer en compte professionnel</h3>
                <button class="modal-close" @onclick="VM.CloseProModal">✕</button>
            </div>

            <div class="modal-body">
                <div class="pro-info-box">
                    <p class="pro-info-text">
                        Accédez à des fonctionnalités exclusives en passant à un compte professionnel.
                    </p>
                </div>

                @if (!string.IsNullOrEmpty(VM.erreurChangeTypeCompte))
                {
                    <div class="error-message-box">
                        @VM.erreurChangeTypeCompte
                    </div>
                }

                <form>
                    <div class="form-group">
                        <label>Raison sociale</label>
                        <input type="text"
                               placeholder="Nom de votre entreprise"
                               @bind="VM.compteModifType.RaisonSociale"
                               class="info-input"
                               required>
                    </div>

                    <div class="form-group">
                        <label>Numéro SIRET</label>
                        <input type="text"
                               placeholder="123 456 789 00012"
                               @bind="VM.compteModifType.NumeroSiret"
                               class="info-input"
                               required>
                        <small class="input-hint">14 chiffres sans espaces</small>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button class="btn-secondary" @onclick="VM.CloseProModal">
                    Annuler
                </button>
                <button class="btn-pro" @onclick="VM.ValidateProAccount">
                    Valider
                </button>
            </div>
        </div>
    </div>
}

@if (VM.showModalA2f)
{
    <div class="modal-overlay" @onclick="VM.CloseModalA2f">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>🔐 Authentification à deux facteurs</h3>
                <button class="modal-close" @onclick="VM.CloseModalA2f">✕</button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(VM.erreurA2f))
                {
                    <div class="error-message-box">
                        @VM.erreurA2f
                    </div>
                }

                @if (!VM.a2fActif)
                {
                    <!-- Activation A2F -->
                    <div class="info-box security">
                        <span class="info-icon">🔒</span>
                        <div>
                            <h4>Protégez votre compte</h4>
                            <p>L'A2F ajoute une couche de sécurité supplémentaire en demandant un code à chaque connexion.</p>
                        </div>
                    </div>

                    @if (!VM.codeA2fEnvoye)
                    {
                        <button class="btn-primary"
                                @onclick="VM.EnvoyerCodeActivationA2f"
                                disabled="@VM.isLoadingA2f">
                            @if (VM.isLoadingA2f)
                            {
                                <span>Envoi en cours...</span>
                            }
                            else
                            {
                                <span>Envoyer le code d'activation</span>
                            }
                        </button>
                    }
                    else
                    {
                        <div class="success-message-box">
                            ✓ Un code a été envoyé à votre adresse email
                        </div>

                        <div class="form-group">
                            <label>Code de vérification</label>
                            <input type="text"
                                   placeholder="1234567"
                                   @bind="VM.codeA2fActivation"
                                   disabled="@VM.isLoadingA2f"
                                   maxlength="7"
                                   class="code-input">
                        </div>

                        <div class="modal-footer">
                            <button class="btn-secondary"
                                    @onclick="VM.EnvoyerCodeActivationA2f"
                                    disabled="@VM.isLoadingA2f">
                                Renvoyer
                            </button>
                            <button class="btn-primary"
                                    @onclick="VM.ValiderCodeActivationA2f"
                                    disabled="@VM.isLoadingA2f">
                                @if (VM.isLoadingA2f)
                                {
                                    <span>Validation...</span>
                                }
                                else
                                {
                                    <span>Activer l'A2F</span>
                                }
                            </button>
                        </div>
                    }
                }
                else
                {
                    <!-- Désactivation A2F -->
                    <div class="info-box active">
                        <span class="info-icon">✓</span>
                        <div>
                            <h4>A2F activé</h4>
                            <p>
                                Votre compte est protégé par l'authentification à deux facteurs.
                                @if (VM.dateActivationA2f.HasValue)
                                {
                                    <br />
                                    <small>Activé le @VM.dateActivationA2f.Value.ToString("dd/MM/yyyy")</small>
                                }
                            </p>
                        </div>
                    </div>

                    @if (VM.doitReactiverA2f)
                    {
                        <div class="warning-box">
                            <p class="warning-text">
                                ⚠️ Votre A2F doit être réactivé pour des raisons de sécurité (plus de 30 jours).
                            </p>
                        </div>
                    }

                    <div class="a2f-danger-zone">
                        <h4>Zone de danger</h4>
                        <p>Désactiver l'A2F rendra votre compte moins sécurisé.</p>
                        <button class="btn-danger-full"
                                @onclick="VM.DesactiverA2f"
                                disabled="@VM.isLoadingA2f">
                            @if (VM.isLoadingA2f)
                            {
                                <span>Désactivation...</span>
                            }
                            else
                            {
                                <span>Désactiver l'A2F</span>
                            }
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}

<div class="compte-container">
    <!-- Section haute - Profil et informations -->
    <div class="profile-header">
        <div class="profile-left">
            <div class="profile-photo-wrapper">
                <img src="@VM.imageSource" alt="Photo de Profil" class="profile-photo" />

                <label for="photoProfil" class="photo-upload-overlay">
                    <div class="upload-icon">📸</div>
                    <p class="upload-text">Cliquez pour @(VM.idImage == 0 ? "ajouter" : "modifier")</p>
                    <p class="upload-hint">JPG, PNG</p>
                </label>
                <InputFile id="photoProfil" OnChange="@VM.UpdateProfileImage" style="display:none" />
            </div>
        </div>

        <div class="profile-info">
            <!-- Menu d'options (roue crantée) -->
            <div class="options-menu-compte">
                <button @onclick="VM.ToggleOptionsMenu" class="btn-options-compte">
                    <span class="menu-icon">⚙️</span>
                </button>

                @if (VM.IsOptionsMenuOpen)
                {
                    <div class="options-dropdown-compte">
                        @if (!VM.isEditing)
                        {
                            <button @onclick="VM.ToggleEdit" class="option-item-compte">
                                <span class="option-icon">✏️</span>
                                <span>Modifier le profil</span>
                            </button>

                            <button @onclick="VM.OpenPasswordModal" class="option-item-compte">
                                <span class="option-icon">🔒</span>
                                <span>Changer le mot de passe</span>
                            </button>

                            <button @onclick="VM.OpenModalA2f" class="option-item-compte">
                                <span class="option-icon">🔐</span>
                                <span>@(VM.a2fActif ? "Gérer l'A2F" : "Activer l'A2F")</span>
                                @if (VM.doitReactiverA2f)
                                {
                                    <span class="badge-warning-mini">!</span>
                                }
                            </button>

                            <button @onclick="(VM.compte.IdTypeCompte == 1 ? VM.OpenProModal : VM.ValidateProAccount)" class="option-item-compte">
                                <span class="option-icon">💼</span>
                                <span>@(VM.compte.IdTypeCompte == 1 ? "Passer en compte pro" : "Passer en personnel")</span>
                            </button>

                            <button @onclick="ConnexionVM.DeconnexionUtilisateur" class="option-item-compte danger">
                                <span class="option-icon">🚪</span>
                                <span>Déconnexion</span>
                            </button>

                            <button @onclick="VM.OpenSuppressionModal" class="option-item-compte danger">
                                <span class="option-icon">🗑️</span>
                                <span>Supprimer mon compte</span>
                            </button>
                        }
                        else
                        {
                            <button @onclick="VM.SaveProfile" class="option-item-compte">
                                <span class="option-icon">💾</span>
                                <span>Enregistrer</span>
                            </button>

                            <button @onclick="VM.CancelEdit" class="option-item-compte">
                                <span class="option-icon">✕</span>
                                <span>Annuler</span>
                            </button>
                        }
                    </div>
                }
            </div>

            @if (VM?.compte == null)
            {
                <p>Chargement...</p>
            }
            else if (!VM.isEditing)
            {
                <div class="info-grid">
                    <div class="info-item">
                        <span class="info-label">Nom</span>
                        <span class="info-value">@VM.compte.Nom</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Prénom</span>
                        <span class="info-value">@VM.compte.Prenom</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Date de naissance</span>
                        <span class="info-value">@VM.compte.DateNaissance.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Pseudo</span>
                        <span class="info-value">@VM.compte.Pseudo</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Email</span>
                        <span class="info-value" data-testid='email-compte'>@VM.compte.Email</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Biographie</span>
                        <span class="info-value">@VM.compte.Biographie</span>
                    </div>
                    @if (VM.compte.IdTypeCompte == 2)
                    {
                        <div class="info-item">
                            <span class="info-label">Raison social</span>
                            <span class="info-value">@VM.compte.RaisonSociale</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Numéro de SIRET</span>
                            <span class="info-value">@VM.compte.NumeroSiret</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="info-grid">
                    <div class="info-item">
                        <label class="info-label">Nom</label>
                        <input type="text" @bind="VM.compteEdit.Nom" class="info-input" />
                    </div>
                    <div class="info-item">
                        <label class="info-label">Prénom</label>
                        <input type="text" @bind="VM.compteEdit.Prenom" class="info-input" />
                    </div>
                    <div class="info-item">
                        <span class="info-label">Date de naissance</span>
                        <span class="info-value">@VM.compte.DateNaissance.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="info-item">
                        <label class="info-label">Pseudo</label>
                        <input type="text" @bind="VM.compteEdit.Pseudo" class="info-input" />
                    </div>
                    <div class="info-item">
                        <label class="info-label">Email</label>
                        <input type="email" @bind="VM.compteEdit.Email" class="info-input" />
                    </div>
                    <div class="info-item">
                        <label class="info-label">Biographie</label>
                        <input type="email" @bind="VM.compteEdit.Biographie" class="info-input" />
                    </div>
                    @if (VM.compte.IdTypeCompte == 2)
                    {
                        <div class="info-item">
                            <label class="info-label">Raison sociale</label>
                            <input type="email" @bind="VM.compteEdit.RaisonSociale" class="info-input" />
                        </div>
                        <div class="info-item">
                            <span class="info-label">Numéro de SIRET</span>
                            <span class="info-value">@VM.compte.NumeroSiret</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Section basse - Navigation et contenu -->
    <div class="account-content">
        <nav class="account-navbar">
            <button class="nav-item @(VM.activeSection == "annonces" ? "active" : "")"
                    @onclick="@(() => VM.SetActiveSection("annonces"))">
                Annonces
            </button>
            <button class="nav-item @(VM.activeSection == "adresses" ? "active" : "")"
                    @onclick="@(() => VM.SetActiveSection("adresses"))">
                Adresses
            </button>
            <button class="nav-item @(VM.activeSection == "commandes" ? "active" : "")"
                    @onclick="@(() => VM.SetActiveSection("commandes"))">
                Commandes
            </button>
            <button class="nav-item @(VM.activeSection == "avis" ? "active" : "")"
                    @onclick="@(() => VM.SetActiveSection("avis"))">
                Avis
            </button>
            <button class="nav-item @(VM.activeSection == "cartes bancaire" ? "active" : "")"
                    @onclick="@(() => VM.SetActiveSection("cartes bancaire"))">
                Cartes Bancaire
            </button>
        </nav>

        <div class="content-section">
            <div class="section-placeholder">
                @switch (VM.activeSection)
                {
                    case "annonces":
                        if (@VM.annonces != null && VM.annonces.Any())
                        {
                            @foreach (var annonce in VM.annonces)
                            {
                                <AnnonceComposant Annonce="annonce" idCompte="VM.compte.IdCompte" divClass="car-card" />
                            }
                        }
                        else
                        {
                            <p>Vous n'avez aucune annonce</p>
                        }
                        break;

                    case "avis":
                        if (@VM.avis != null && VM.avis.Any())
                        {
                            @foreach (var av in VM.avis)
                            {
                                <AvisComposant Avis="av" idCompte="@VM.compte.IdCompte"/>
                            }
                        }
                        else
                        {
                            <p>Vous n'avez aucun avis</p>
                        }
                        break;

                    case "adresses":
                        @if (@VM.adresses != null && VM.adresses.Any())
                        {
                            @foreach (var adresse in VM.adresses)
                            {
                                <div class="adresse-card-wrapper">
                                    <AdresseComposant Adresse="adresse"
                                                      ShowActions="true"
                                                      OnEdit="@((a) => VM.OpenEditAdresseModal(a))"
                                                      OnDelete="@((a) => VM.DeleteAdresse(a))" />
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                <div class="empty-icon">📍</div>
                                <h3>Aucune adresse enregistrée</h3>
                                <p>Ajoutez votre première adresse pour faciliter vos futures annonces</p>
                            </div>
                        }
                        break;

                    case "commandes":
                        if (@VM.commandes != null && VM.commandes.Any())
                        {
                            @foreach (var commande in VM.commandes)
                            {
                                <CommandeComposant Commande="@commande" />
                            }
                        }
                        else
                        {
                            <p>Vous n'avez aucune commande</p>
                        }
                        break;

                    case "cartes bancaire":
                        @if (@VM.carteBancaires != null && VM.carteBancaires.Any())
                        {
                            @foreach (var carteBancaire in VM.carteBancaires)
                            {
                                <CarteBancaireComposant CarteBancaire="@carteBancaire"
                                                        ShowActions="true"
                                                        OnDelete="@((cb) => VM.DeleteCarte(cb))" />
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                <div class="empty-icon">💳</div>
                                <h3>Aucune carte bancaire enregistrée</h3>
                                <p>Ajoutez votre première carte pour faciliter vos paiements</p>
                            </div>
                        }
                        break;
                }
            </div>

            @if (VM.activeSection == "adresses")
            {
                <div class="cartes-header">
                    <button class="btn-add-carte" @onclick="VM.OpenCreateAdresseModal">
                        <span class="add-icon">➕</span>
                        <span>Ajouter une adresse</span>
                    </button>
                </div>
            }
            else if (VM.activeSection == "cartes bancaire")
            {
                <div class="cartes-header">
                    <button class="btn-add-carte" @onclick="VM.OpenCreateCarteModal">
                        <span class="add-icon">💳</span>
                        <span>Ajouter une carte bancaire</span>
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        ConnexionVM.SetNavigation(Navigation);
        await VM.InitializeAsync(StateHasChanged, Navigation);
    }
}