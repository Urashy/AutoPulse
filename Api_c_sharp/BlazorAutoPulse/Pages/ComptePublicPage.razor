@page "/comptepublic/{IdUtilisateur:int}"
@using BlazorAutoPulse.ViewModel
@inject ComptePublicViewModel VM
@inject SignalementViewModel SignalementVM
@inject NavigationManager Navigation

<PageTitle>@(VM.compte?.Pseudo ?? "Profil utilisateur") - AutoPulse</PageTitle>

@if (VM.isLoading)
{
    <div class="loading-container">
        <div class="loader"></div>
        <p>Chargement du profil...</p>
    </div>
}
else if (VM.compte == null)
{
    <div class="error-container">
        <h2>Utilisateur introuvable</h2>
        <p>L'utilisateur que vous recherchez n'existe pas.</p>
        <button @onclick="VM.RedirectionAccueil" class="btn-back">Retour à l'accueil</button>
    </div>
}
else
{
    <div class="compte-public-container">
        <!-- En-tête avec retour et menu options -->
        <div class="header-nav">
            <button @onclick="VM.RedirectionAccueil" class="btn-back">← Retour</button>
            
            <div class="header-actions">
                <!-- Menu d'options -->
                <div class="options-menu">
                    <button @onclick="VM.ToggleOptionsMenu" class="btn-options">
                        <span class="menu-icon">⚙️</span>
                    </button>
                    
                    @if (VM.IsOptionsMenuOpen)
                    {
                        <div class="options-dropdown">
                            <button @onclick="VM.EnvoyerMessage"
                                    @onmouseenter="() => VM.SetInfoOption(infoMessage)"
                                    @onmouseleave="() => VM.SetInfoOption(null)"
                                    class="option-item">
                                <span class="option-icon">✉️</span>
                                <span>Envoyer un message</span>
                            </button>

                            <button @onclick="() => SignalementVM.OpenModalUser(VM.compte.IdCompte)"
                                    @onmouseenter="() => VM.SetInfoOption(infoSignaler)"
                                    @onmouseleave="() => VM.SetInfoOption(null)"
                                    class="option-item">
                                <span class="option-icon">⚠️</span>
                                <span>Signaler l'utilisateur</span>
                            </button>
                            
                            @if (!string.IsNullOrEmpty(VM.infoOption))
                            {
                                <div class="option-info">
                                    @VM.infoOption
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Section profil public -->
        <div class="profile-header">
            <div class="profile-left">
                <div class="profile-photo-wrapper">
                    <img src="@VM.imageSource" alt="Photo de Profil" class="profile-photo" />
                </div>
            </div>

            <div class="profile-info">
                <div class="user-header">
                    <div>
                        <h1 class="user-pseudo">@VM.compte.Pseudo</h1>
                        <p class="user-type">@VM.compte.TypeCompte</p>
                    </div>
                    @if (VM.compte.IdTypeCompte == 2)
                    {
                        <div class="pro-badge">
                            <span class="badge-icon">💼</span>
                            <span>Professionnel</span>
                        </div>
                    }
                </div>

                <div class="info-grid">
                    <div class="info-item bio-item">
                        <span class="info-label">📝 Biographie</span>
                        @if (!string.IsNullOrEmpty(VM.compte.Biographie))
                        {
                            <span class="info-value">@VM.compte.Biographie</span>
                        }
                    </div>
                    @if (VM.compte.IdTypeCompte == 2 && !string.IsNullOrEmpty(VM.compte.RaisonSociale))
                    {
                        <div class="info-item">
                            <span class="info-label">🏢 Raison sociale</span>
                            <span class="info-value">@VM.compte.RaisonSociale</span>
                        </div>
                    }
                </div>

                <div class="profile-stats">
                    <div class="stat-item">
                        <span class="stat-value">@VM.compte.NombreAnnonces</span>
                        <span class="stat-label">Annonces</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-value">@VM.compte.NombreAvis</span>
                        <span class="stat-label">Avis</span>
                    </div>
                    @if (VM.compte.NoteMoyenne != null)
                    {
                        <div class="stat-item">
                            <span class="stat-value">@VM.compte.NoteMoyenne ⭐</span>
                            <span class="stat-label">Note moyenne</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Section contenu public -->
        <div class="account-content">
            <nav class="account-navbar">
                <button class="nav-item @(VM.activeSection == "annonces" ? "active" : "")"
                        @onclick="@(() => VM.SetActiveSection("annonces"))">
                    📋 Annonces (@VM.compte.NombreAnnonces)
                </button>
                <button class="nav-item @(VM.activeSection == "avis" ? "active" : "")"
                        @onclick="@(() => VM.SetActiveSection("avis"))">
                    ⭐ Avis (@VM.compte.NombreAvis)
                </button>
            </nav>

            <div class="content-section">
                @switch(VM.activeSection)
                {
                    case "annonces":
                        @if (VM.annonces != null && VM.annonces.Any())
                        {
                            <div class="annonces-grid">
                                <h4>Oui y'a une annonce</h4>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <span class="empty-icon">📋</span>
                                <p>Aucune annonce publiée</p>
                            </div>
                        }
                        break;

                    case "avis":
                        @if (VM.avis != null && VM.avis.Any())
                        {
                            <div class="avis-list">
                                <h4>Oui y'a un avis</h4>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <span class="empty-icon">⭐</span>
                                <p>Aucun avis pour le moment</p>
                            </div>
                        }
                        break;
                }
            </div>
        </div>

        <SignalementModal VM="@SignalementVM"/>
    </div>
}

<SignalementModal VM="@SignalementVM" genreSignalement="compte"/>

@code {
    [Parameter] public int IdUtilisateur { get; set; }

    private string infoMessage = "Envoyer un message privé à cet utilisateur";
    private string infoSignaler = "Signaler cet utilisateur pour comportement inapproprié";

    protected override async Task OnInitializedAsync()
    {
        await VM.InitializeAsync(IdUtilisateur, StateHasChanged, Navigation);
        await SignalementVM.InitializeAsync(StateHasChanged);
    }
}