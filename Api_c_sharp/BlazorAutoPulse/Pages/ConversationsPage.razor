@page "/conversations"
@using BlazorAutoPulse.ViewModel
@inject ConversationViewModel VM
@implements IDisposable

<PageTitle>Mes Conversations - AutoPulse</PageTitle>

<div class="conversations-container">
    <div class="conversations-sidebar">
        <div class="sidebar-header">
            <h2>💬 Conversations</h2>

            <!-- NOUVEAU : Filtre par annonce -->
            <div class="annonce-filter">
                @if (VM.IsLoadingAnnonces)
                {
                    <div class="loading-filter">⏳ Chargement...</div>
                }
                else if (VM.MesAnnonces.Any())
                {
                    <div class="annonce-filter-select-wrapper">
                        <select class="select-annonce-conversation" @onchange="@VM.SelectAnnonceFilter">
                            <option value="0" selected="@(VM.SelectedAnnonceFilter == 0)">
                                📋 Toutes les annonces (@VM.Conversations.Count)
                            </option>
                            @foreach (var annonce in VM.MesAnnonces)
                            {
                                var convCount = VM.Conversations.Count(c => c.IdAnnonce == annonce.IdAnnonce);
                                if (convCount > 0)
                                {
                                    <option value="@annonce.IdAnnonce"
                                            selected="@(VM.SelectedAnnonceFilter == annonce.IdAnnonce)">
                                        🚗 @(annonce.Libelle?.Length > 30 ? annonce.Libelle.Substring(0, 30) + "..." : annonce.Libelle) (@convCount)
                                    </option>
                                }
                            }
                        </select>
                        <span class="select-arrow">▼</span>
                    </div>
                }
                else
                {
                    <div class="no-annonces-filter">Aucune annonce avec conversations</div>
                }
            </div>
        </div>

        @if (VM.IsLoading)
        {
            <div class="loading">Chargement...</div>
        }
        else if (!VM.ConversationsFiltered.Any())
        {
            <div class="empty-state">
                @if (VM.SelectedAnnonceFilter > 0)
                {
                    <p>Aucune conversation pour cette annonce</p>
                }
                else
                {
                    <p>Aucune conversation</p>
                }
            </div>
        }
        else
        {
            @foreach (var conv in VM.ConversationsFiltered)
            {
                <div class="conversation-item @(VM.SelectedConversation?.IdConversation == conv.IdConversation ? "active" : "")"
                     @onclick="() => VM.SelectConversation(conv)">
                    <div class="conversation-avatar">
                        @if (VM.ImageSources.ContainsKey(conv.IdParticipant) &&
                             !string.IsNullOrEmpty(VM.ImageSources[conv.IdParticipant]))
                        {
                            <img src="@VM.ImageSources[conv.IdParticipant]"
                                 alt="Profile"
                                 class="avatar-img" />
                        }
                        else
                        {
                            <span>👤</span>
                        }
                    </div>
                    <div class="conversation-info">
                        <div class="conversation-header-row">
                            <h4>@conv.LibelleAnnonce</h4>
                            @if (conv.AOffre)
                            {
                                <span class="offre-badge @(conv.OffreAccepte == null ? "" : conv.OffreAccepte == true ? "offre-accepte" : "offre-refuse")">💰 Offre @(conv.AOffre && VM.MesAnnonces.Any(m => m.IdAnnonce == conv.IdAnnonce)? "reçu" : "envoyé")</span>
                            }
                        </div>
                        <p class="last-message">
                            @(string.IsNullOrEmpty(conv.DernierMessage) ? "Aucun message" :
                            conv.DernierMessage.Length > 40 ? conv.DernierMessage.Substring(0, 40) + "..." : conv.DernierMessage)
                        </p>
                    </div>
                    @if (conv.NombreNonLu > 0)
                    {
                        <span class="unread-badge">@conv.NombreNonLu</span>
                    }
                </div>
            }
        }
    </div>

    <div class="conversation-content">
        @if (VM.SelectedConversation == null)
        {
            <div class="empty-conversation">
                <h3>Sélectionnez une conversation</h3>
                <p>Choisissez une conversation pour voir les messages</p>
            </div>
        }
        else
        {
            <div class="conversation-header">
                <div class="conversation-avatar">
                    @if (VM.ImageSources.ContainsKey(VM.SelectedConversation.IdParticipant) &&
                         !string.IsNullOrEmpty(VM.ImageSources[VM.SelectedConversation.IdParticipant]))
                    {
                        <img src="@VM.ImageSources[VM.SelectedConversation.IdParticipant]"
                             alt="Profile"
                             class="avatar-img" />
                    }
                    else
                    {
                        <span>👤</span>
                    }
                </div>
                <div class="conversation-info-header">
                    <h3>@VM.SelectedConversation.LibelleAnnonce</h3>
                    <NavLink href="@($"/comptepublic/{VM.SelectedConversation.IdParticipant}")" class="participant-link">
                        <span class="participant-name">@VM.SelectedConversation.ParticipantPseudo</span>
                        <svg class="link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 12h14M12 5l7 7-7 7" />
                        </svg>
                    </NavLink>
                </div>

                @if (VM.CommandeEnCours != null)
                {
                    <NavLink href="@($"/commande/{VM.CommandeEnCours.IdCommande}")" class="commande-link-header">
                        <span class="commande-icon">📦</span>
                        <span class="commande-text">Commande #@VM.CommandeEnCours.IdCommande</span>
                        <svg class="link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 12h14M12 5l7 7-7 7" />
                        </svg>
                    </NavLink>
                }
            </div>

            <MessageContainer Messages="@VM.Messages"
                              CurrentUserId="@VM.CurrentUserId"
                              ParticipantId="@VM.SelectedConversation.IdParticipant"
                              IsLoadingMessages="@VM.IsLoadingMessages"
                              IsTyping="@VM.IsTyping"
                              ConversationId="@VM.SelectedConversation.IdConversation"
                              BlocageType="@VM.BlocageType"
                              OnOffreAccept="@VM.AccepterOffre"
                              OnOffreRefuse="@VM.RefuserOffre" />

            <div class="message-input-area">
                <div class="input-toolbar">
                    <button class="toolbar-btn @(VM.ShowOffreMode ? "active" : "")"
                            @onclick="VM.ToggleOffreMode"
                            title="Faire une offre"
                            disabled="@VM.EstBloquer">
                        💰
                    </button>

                    <FileUploadComponent OnFilesSelected="@VM.OnFilesSelected" />
                </div>

                @if (VM.ShowOffreMode)
                {
                    <div class="offre-input-zone">
                        <div class="offre-input-header">
                            <span class="offre-label">
                                💰 Montant de l'offre
                            </span>
                            @if (VM.AnnoncePrixMax.HasValue)
                            {
                                <span class="offre-max">Prix demandé: @VM.AnnoncePrixMax.Value.ToString("N0") €</span>
                            }
                        </div>
                        <div class="offre-input-wrapper">
                            <input type="number"
                                   class="offre-input-field"
                                   placeholder="Ex: 15000"
                                   min="1"
                                   step="100"
                                   value="@VM.OffreAmount"
                                   @oninput="@(e => VM.UpdateOffreAmount(e.Value?.ToString() ?? "0"))"
                                   disabled="@VM.EstBloquer" />
                            <span class="offre-currency">€</span>
                        </div>

                        @if (!string.IsNullOrEmpty(VM.OffreError))
                        {
                            <small class="offre-error">⚠️ @VM.OffreError</small>
                        }
                        else if (!string.IsNullOrEmpty(VM.OffreInfoMessage))
                        {
                            <small class="@VM.OffreInfoClass">
                                @VM.OffreInfoMessage
                            </small>
                        }
                    </div>
                }

                @if (VM.SelectedFiles.Any())
                {
                    <div class="selected-files-preview">
                        @foreach (var file in VM.SelectedFiles)
                        {
                            <div class="file-preview-item">
                                <span class="file-name">📎 @file.Name</span>
                                <button @onclick="() => VM.RemoveFile(file)" class="remove-file-btn">✕</button>
                            </div>
                        }
                    </div>
                }

                <div class="message-input-container">
                    <input type="text"
                           placeholder="@(VM.ShowOffreMode ? "Ajoutez un message avec votre offre..." : "Tapez votre message...")"
                           value="@VM.NewMessage"
                           @oninput="VM.OnInputChanged"
                           @onkeyup="VM.HandleTyping"
                           @onkeydown="VM.HandleKeyPress"
                           class="message-input"
                           disabled="@((VM.IsUploadingFiles || VM.EstBloquer) ? true : (bool?)null)" />

                    <button @onclick="@(VM.ShowOffreMode ? VM.SendMessageWithOffre : VM.SendMessageWithOffre)"
                            class="send-btn @(VM.ShowOffreMode ? "offre-mode" : "")"
                            disabled="@((string.IsNullOrWhiteSpace(VM.NewMessage) && !VM.SelectedFiles.Any() && (!VM.ShowOffreMode || VM.OffreAmount <= 0)) || VM.IsUploadingFiles)">
                        @if (VM.IsUploadingFiles)
                        {
                            <span class="spinner">⏳</span>
                        }
                        else if (VM.ShowOffreMode)
                        {
                            <span>💰</span>
                        }
                        else
                        {
                            <span>➤</span>
                        }
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        VM._refreshUI += StateHasChanged;
        await VM.InitializeAsync();
    }

    public void Dispose()
    {
        VM._refreshUI -= StateHasChanged;
        VM.Dispose();
    }
}