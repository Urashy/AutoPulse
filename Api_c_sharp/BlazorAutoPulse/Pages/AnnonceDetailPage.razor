@page "/annonce/{IdAnnonce:int}"
@using BlazorAutoPulse.ViewModel
@using BlazorAutoPulse.Composant
@inject SignalementViewModel SignalementVM
@inject AnnonceDetailViewModel VM
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>@(VM.Annonce?.Libelle ?? "Détail de l'annonce") - AutoPulse</PageTitle>

@* Popup Contact Vendeur *@
@if (VM.showContactPopup)
{
    <div class="popup-overlay" @onclick="VM.CloseContactPopup">
        <div class="popup-container popup-contact" @onclick:stopPropagation>
            <div class="popup-header">
                <h3>✉️ Contacter le vendeur</h3>
                <button class="btn-close-popup" @onclick="VM.CloseContactPopup">✕</button>
            </div>
            <div class="popup-content">
                <div class="contact-info">
                    <div class="seller-badge">
                        <img src="@VM.ProfileImageSource" alt="Vendeur" class="seller-mini-picture" />
                        <div>
                            <p class="seller-name-popup">@VM.Annonce?.PseudoVendeur</p>
                            <p class="seller-type-popup">@VM.Annonce?.TypeCompteVendeur</p>
                        </div>
                    </div>
                    <div class="annonce-ref">
                        <span class="ref-label">Annonce:</span>
                        <span class="ref-value">@VM.Annonce?.Libelle</span>
                    </div>
                </div>

                <div class="message-input-group">
                    <label for="contactMessage">Votre message</label>
                    <textarea
                        id="contactMessage"
                        class="contact-textarea"
                        placeholder="Bonjour, je suis intéressé par votre annonce..."
                        rows="6"
                        maxlength="1000"
                        @bind="VM.contactMessage"
                        @bind:event="oninput"
                        disabled="@VM.isLoadingContact"></textarea>
                    <div class="char-counter">
                        @VM.contactMessage.Length / 1000 caractères
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(VM.contactError))
                {
                    <div class="contact-error">
                        ⚠️ @VM.contactError
                    </div>
                }
            </div>
            <div class="popup-actions">
                <button class="btn-cancel" @onclick="VM.CloseContactPopup" disabled="@VM.isLoadingContact">
                    Annuler
                </button>
                <button class="btn-confirm btn-send" @onclick="VM.SendContactMessage" disabled="@VM.isLoadingContact">
                    @if (VM.isLoadingContact)
                    {
                        <span class="btn-loading">
                            <span class="mini-spinner"></span>
                            Envoi...
                        </span>
                    }
                    else
                    {
                        <span>📤 Envoyer</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@* Popup Warning Prix *@
@if (VM.showPriceWarningPopup)
{
    <div class="popup-overlay">
        <div class="popup-container">
            <div class="popup-header">
                <h3>⚠️ Champs manquants</h3>
            </div>
            <div class="popup-content">
                <p>Les champs suivants ne sont pas disponibles :</p>
                <ul class="missing-fields-list">
                    @foreach (var field in VM.missingFields)
                    {
                        <li>• @field</li>
                    }
                </ul>
                <p><strong>L'IA risque d'être moins précise. Voulez-vous continuer ?</strong></p>
            </div>
            <div class="popup-actions">
                <button class="btn-cancel" @onclick="VM.ClosePriceWarningPopup">Annuler</button>
                <button class="btn-confirm" @onclick="VM.ExecutePricePrediction">Continuer quand même</button>
            </div>
        </div>
    </div>
}

@* Popup Loading Prix *@
@if (VM.showPriceLoadingPopup)
{
    <div class="popup-overlay">
        <div class="popup-container popup-loading">
            <div class="loading-spinner"></div>
            <p>Prédiction du prix en cours...</p>
        </div>
    </div>
}

@* Popup Warning Ajustement *@
@if (VM.showAdjustmentWarningPopup)
{
    <div class="popup-overlay">
        <div class="popup-container">
            <div class="popup-header">
                <h3>⚠️ Ajustement par IA</h3>
            </div>
            <div class="popup-content">
                <p>L'IA va analyser la description de l'annonce pour détecter d'éventuels défauts et estimer un prix ajusté.</p>
                <p><strong>⚠️ Attention :</strong> L'IA peut faire des erreurs, cette estimation est indicative.</p>
            </div>
            <div class="popup-actions">
                <button class="btn-cancel" @onclick="VM.CloseAdjustmentWarningPopup">Annuler</button>
                <button class="btn-confirm" @onclick="VM.ExecuteAdjustment">Analyser</button>
            </div>
        </div>
    </div>
}

@* Popup Loading Ajustement *@
@if (VM.showAdjustmentLoadingPopup)
{
    <div class="popup-overlay">
        <div class="popup-container popup-loading">
            <div class="loading-spinner"></div>
            <p>Analyse de la description en cours...</p>
        </div>
    </div>
}

@* Popup Résultat Ajustement *@
@if (VM.showAdjustmentResultPopup && VM.adjustmentResult != null)
{
    <div class="popup-overlay">
        <div class="popup-container popup-large">
            <div class="popup-header">
                <h3>📊 Résultat de l'analyse</h3>
            </div>
            <div class="popup-content">
                <div class="adjustment-result">
                    <div class="adjustment-category">
                        <strong>Catégorie :</strong> @VM.adjustmentResult.Category
                    </div>

                    <div class="price-comparison">
                        <div class="price-item">
                            <span class="price-label">Prix actuel</span>
                            <span class="price-value">@VM.adjustmentResult.BasePrice.ToString("N0") €</span>
                        </div>
                        <div class="price-arrow">→</div>
                        <div class="price-item">
                            <span class="price-label">Prix ajusté estimé</span>
                            <span class="price-value adjusted">@VM.adjustmentResult.AdjustedPrice.ToString("N0") €</span>
                        </div>
                    </div>

                    <div class="reduction-info">
                        <p><strong>Différence :</strong> @VM.adjustmentResult.ReductionAmount.ToString("N0") € (@(VM.adjustmentResult.ReductionPercent >= 0 ? "-" : "+")@Math.Abs(VM.adjustmentResult.ReductionPercent).ToString("N2")%)</p>
                        <p><strong>Coefficient de qualité :</strong> @VM.adjustmentResult.QualityCoefficient.ToString("N2")</p>
                    </div>

                    <div class="description-analyzed">
                        <p><strong>Description analysée :</strong></p>
                        <p class="description-text">@VM.adjustmentResult.DescriptionAnalyzed</p>
                    </div>
                </div>
            </div>
            <div class="popup-actions">
                <button class="btn-confirm" @onclick="VM.CloseAdjustmentResultPopup">OK</button>
            </div>
        </div>
    </div>
}

@if (VM.IsLoading)
{
    <div class="loading-container">
        <div class="loader"></div>
        <p>Chargement des détails...</p>
    </div>
}
else if (VM.Annonce == null)
{
    <div class="error-container">
        <h2>Annonce introuvable</h2>
        <p>L'annonce que vous recherchez n'existe pas ou a été supprimée.</p>
        <button @onclick="() => Navigation.NavigateTo('/'.ToString())" class="btn-back">Retour à l'accueil</button>
    </div>
}
else
{
    <div class="detail-container">
        <!-- En-tête avec retour et menu options -->
        <div class="header-nav">
            <button @onclick="() => Navigation.NavigateTo('/'.ToString())" class="btn-back">← Retour</button>
            
            <div class="header-actions">
                <button @onclick="VM.ToggleViewer3D" class="btn-3d">
                    @(VM.show3DViewer ? "🖼️ Voir les photos" : "🎨 Visualiseur 3D")
                </button>

                <!-- Photo de profil du vendeur -->
                <button @onclick="VM.VoirProfilVendeur" class="seller-profile-badge">
                    <img src="@VM.ProfileImageSource" alt="Vendeur" class="seller-profile-picture" />
                </button>

                <!-- Menu d'options -->
                <div class="options-menu">
                    <button @onclick="VM.ToggleOptionsMenu" class="btn-options">
                        <span class="menu-icon">⚙️</span>
                    </button>
                    
                    @if (VM.IsOptionsMenuOpen)
                    {
                        <div class="options-dropdown">
                            @if (VM.CurrentUserId == VM.Annonce.IdVendeur)
                            {
                                <button @onclick="VM.RedirectToModif"
                                        @onmouseenter="() => VM.SetInfoOption(infoModif)"
                                        @onmouseleave="() => VM.SetInfoOption(null)"
                                        class="option-item">

                                    <span class="option-icon">✏️️</span>
                                    <span>Modifier votre annonce</span>
                                </button>
                                
                                <button @onclick="VM.estMasquer ? VM.DemasquerAnnonce : VM.MasquerAnnonce"
                                        @onmouseenter="() => VM.SetInfoOption(VM.estMasquer ? infoDemasquer : infoMasquer)"
                                        @onmouseleave="() => VM.SetInfoOption(null)"
                                        class="option-item">

                                    <span class="option-icon">👁️</span>
                                    <span>@(VM.estMasquer ? "Démasquer l'annonce" : "Masquer l'annonce")</span>
                                </button>

                                <button @onclick="VM.SupprimerAnnonce"
                                        @onmouseenter="() => VM.SetInfoOption(infoSupprimer)"
                                        @onmouseleave="() => VM.SetInfoOption(null)"
                                        class="option-item danger">
                                    <span class="option-icon">🗑️</span>
                                    <span>Supprimer l'annonce</span>
                                </button>
                            }
                            else
                            {
                                <button @onclick="() => SignalementVM.OpenModalAnnonce(VM.Annonce.IdAnnonce)"
                                        @onmouseenter="() => VM.SetInfoOption(infoSignaler)"
                                        @onmouseleave="() => VM.SetInfoOption(null)"
                                        class="option-item">
                                    <span class="option-icon">⚠️</span>
                                    <span>Signaler l'annonce</span>
                                </button>
                            }
                            
                            @if (!string.IsNullOrEmpty(VM.infoOptionAnnonce))
                            {
                                <div class="option-info">
                                    @VM.infoOptionAnnonce
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Visualiseur 3D (optionnel) -->
        @if (VM.show3DViewer)
        {
            <div class="viewer-3d-section">
                <div class="controls-panel">
                    <div class="color-selector">
                        <h3>🎨 Couleur</h3>
                        <div class="color-options">
                            @foreach (var color in VM.couleurDisponible)
                            {
                                <div class="color-option @(VM.selectedColor == color.CodeHexaCouleur ? "selected" : "")"
                                     style="background-color: @color.CodeHexaCouleur"
                                     @onclick="() => VM.ChangeCouleur(color.CodeHexaCouleur)"
                                     title="@color.LibelleCouleur">
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="viewer-3d-container">
                    <div id="car3DViewer" class="viewer-3d"></div>
                    @if (VM.isLoading3D)
                    {
                        <div class="viewer-3d-loading">
                            <div class="loader"></div>
                            <p>Chargement du modèle 3D...</p>
                        </div>
                    }
                    else if (VM.is3DReady && !VM.isLoading3D)
                    {
                        <div class="viewer-3d-badge">
                            ✅ Modèle 3D prêt
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- Conteneur caché pour le préchargement -->
            <div style="position: absolute; left: -9999px; width: 800px; height: 600px; visibility: hidden;">
                <div id="car3DViewer" class="viewer-3d"></div>
            </div>

            <!-- Section images -->
            <div class="images-section">
                <div class="main-image">
                    @if (VM.CurrentImageIndex >= 0 && VM.ImageIds.Any())
                    {
                        <img src="@VM.GetCurrentImage()" alt="@VM.Annonce.Libelle" />
                    }
                    else
                    {
                        <div class="no-image">Aucune image disponible</div>
                    }
                </div>

                @if (VM.ImageIds.Count > 1)
                {
                    <div class="image-navigation">
                        <button @onclick="VM.PreviousImage" class="nav-btn" disabled="@(!VM.CanGoPrevious)">
                            ◀
                        </button>
                        <div class="image-counter">
                            @(VM.CurrentImageIndex + 1) / @VM.ImageIds.Count
                        </div>
                        <button @onclick="VM.NextImage" class="nav-btn" disabled="@(!VM.CanGoNext)">
                            ▶
                        </button>
                    </div>

                    <div class="thumbnails">
                        @for (int i = 0; i < VM.ImageIds.Count; i++)
                        {
                            var index = i;
                            <div class="thumbnail @(index == VM.CurrentImageIndex ? "active" : "")"
                                 @onclick="() => VM.SelectImage(index)">
                                <img src="@VM.GetImageUrl(VM.ImageIds[index])" alt="Miniature @(index + 1)" />
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <div class="stats-container">
            <div class="stat-item" title="Nombre de vues">
                <span class="stat-icon">👁️</span>
                <span class="stat-value">
                    @VM.Annonce.NbVues @(VM.Annonce.NbVues <= 1 ? "vue" : "vues")
                </span>
            </div>

            <div class="stat-item" title="uwu">
                <span class="stat-icon">❤️</span>
                <span class="stat-value">
                    @VM.Annonce.NbFavoris @(VM.Annonce.NbFavoris <= 1 ? "favori" : "favoris")
                </span>
            </div>
        </div>

        <!-- Reste du code existant (informations principales, caractéristiques, etc.) -->
        <div class="main-info-section">
            <div class="price-section">
                <h1>@VM.Annonce.Libelle</h1>
                <div class="price">@VM.Annonce.Prix.ToString("N0") €</div>
            </div>

            <div class="key-specs">
                <div class="spec-item">
                    <span class="spec-label">📅 Année</span>
                    <span class="spec-value">@VM.Annonce.Annee</span>
                </div>
                <div class="spec-item">
                    <span class="spec-label">📊 Kilométrage</span>
                    <span class="spec-value">@VM.Annonce.Kilometrage.ToString() km</span>
                </div>
                <div class="spec-item">
                    <span class="spec-label">⛽ Carburant</span>
                    <span class="spec-value">@VM.Annonce.Carburant</span>
                </div>
                <div class="spec-item">
                    <span class="spec-label">📍 Localisation</span>
                    <span class="spec-value">@VM.Annonce.Ville (@VM.Annonce.CodePostal)</span>
                </div>
            </div>

            <!-- Vendeur -->
            <div class="seller-section">
                <h3>Vendeur</h3>
                <div class="seller-info">
                    <div class="seller-details">
                        <p class="seller-name">@VM.Annonce.PseudoVendeur</p>
                        <p class="seller-type">@VM.Annonce.TypeCompteVendeur</p>
                    </div>
                    <button class="btn-contact" @onclick="VM.OpenContactPopup">Contacter le vendeur</button>
                </div>
            </div>
        </div>

        <!-- Caractéristiques détaillées -->
        <div class="details-section">
            <h2>Caractéristiques détaillées</h2>
            <div class="specs-grid">
                <div class="spec-group">
                    <h3>Général</h3>
                    <div class="spec-row">
                        <span>Marque</span>
                        <span>@VM.Annonce.Marque</span>
                    </div>
                    <div class="spec-row">
                        <span>Modèle</span>
                        <span>@VM.Annonce.Modele</span>
                    </div>
                    <div class="spec-row">
                        <span>Année</span>
                        <span>@VM.Annonce.Annee</span>
                    </div>
                    <div class="spec-row">
                        <span>Couleur</span>
                        <span>@VM.Annonce.Couleur</span>
                    </div>
                    <div class="spec-row">
                        <span>Catégorie</span>
                        <span>@VM.Annonce.Categorie</span>
                    </div>
                    <div class="spec-row">
                        <span>Nombre de porte</span>
                        <span>@VM.Annonce.NbPortes</span>
                    </div>
                    <div class="spec-row">
                        <span>Nombre de place</span>
                        <span>@VM.Annonce.NbPlaces</span>
                    </div>
                    <div class="spec-row">
                        <span>Intérieur cuire</span>
                        <span>@(VM.Annonce.InterieurCuire? "Oui" : "Non")</span>
                    </div>
                    <div class="spec-row">
                        <span>Position du volant</span>
                        <span>@(VM.Annonce.PositionVolant? "Gauche" : "Droite")</span>
                    </div>
                </div>

                <div class="spec-group">
                    <h3>Motorisation</h3>
                    <div class="spec-row">
                        <span>Puissance</span>
                        <span>@VM.Annonce.Puissance ch</span>
                    </div>
                    <div class="spec-row">
                        <span>Couple</span>
                        <span>@VM.Annonce.Couple Nm</span>
                    </div>
                    <div class="spec-row">
                        <span>Cylindres</span>
                        <span>@VM.Annonce.NbCylindres</span>
                    </div>
                    <div class="spec-row">
                        <span>Boîte de vitesse</span>
                        <span>@VM.Annonce.BoiteDeVitesse</span>
                    </div>
                    <div class="spec-row">
                        <span>Motricité</span>
                        <span>@VM.Annonce.Motricite</span>
                    </div>
                    <div class="spec-row">
                        <span>Cylindré du moteur</span>
                        <span>@VM.Annonce.CylindrerMoteur L</span>
                    </div>
                </div>
            </div>
        </div>

        @if (VM.Annonce != null)
        {
            <!-- Section IA - Estimation de prix -->
            <div class="ia-section">
                <h2>🤖 Estimations par Intelligence Artificielle</h2>
                <p class="ia-disclaimer">
                    Ces estimations sont générées par IA et sont fournies à titre indicatif uniquement.
                </p>

                <div class="ia-actions">
                    <button class="btn-ia btn-ia-price" @onclick="VM.CheckAndPredictPrice">
                        <span class="ia-icon">✨</span>
                        <div class="ia-btn-content">
                            <span class="ia-btn-title">Estimer le prix du marché</span>
                            <span class="ia-btn-desc">Prédiction basée sur les caractéristiques</span>
                        </div>
                    </button>

                    <button class="btn-ia btn-ia-adjustment"
                            disabled="@(!VM.CanUseAdjustment)"
                            @onclick="VM.OpenAdjustmentWarningPopup">
                        <span class="ia-icon">🔍</span>
                        <div class="ia-btn-content">
                            <span class="ia-btn-title">Analyser la description</span>
                            <span class="ia-btn-desc">Ajustement selon l'état décrit</span>
                        </div>
                    </button>
                </div>

                @* Affichage du résultat de prédiction *@
                @if (VM.priceResult != null && VM.priceResult.Success)
                {
                    <div class="ia-price-result">
                        <div class="ia-result-header">
                            <span class="ia-result-icon">💰</span>
                            <h3>Prix estimé par l'IA</h3>
                        </div>
                        <div class="predicted-price">
                            @VM.priceResult.PredictedPrice.ToString("N0") @VM.priceResult.Currency
                            <span class="confidence-badge">
                        Confiance: @((VM.priceResult.ConfidenceScore * 100).ToString("N0"))%
                    </span>
                        </div>

                        @if (VM.priceResult.TopInfluencingFactors?.Any() == true)
                        {
                            <div class="influencing-factors">
                                <p class="factors-title">Facteurs les plus influents :</p>
                                @foreach (var factor in VM.priceResult.TopInfluencingFactors.Take(3))
                                {
                                    <div class="factor-item">
                                        <span class="factor-name">@factor.Feature</span>
                                        <div class="factor-bar">
                                            <div class="factor-fill" style="width: @((factor.Importance * 100).ToString("F0"))%"></div>
                                        </div>
                                        <span class="factor-value">@((factor.Importance * 100).ToString("F0"))%</span>
                                    </div>
                                }
                            </div>
                        }

                        <div class="price-comparison-info">
                            @{
                                var difference = VM.priceResult.PredictedPrice - VM.Annonce.Prix;
                                var percentage = (difference / VM.Annonce.Prix) * 100;
                            }
                            @if (Math.Abs(difference) > 1000)
                            {
                                <div class="comparison-badge @(difference > 0 ? "higher" : "lower")">
                                    Le prix annoncé est
                                    <strong>@(difference > 0 ? $"{difference:N0} € moins cher" : $"{Math.Abs(difference):N0} € plus cher")</strong>
                                    que l'estimation (@percentage.ToString("F1")%)
                                </div>
                            }
                            else
                            {
                                <div class="comparison-badge equal">
                                    Le prix annoncé est proche de l'estimation du marché
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Actions -->
        <div class="actions-section">
            @if (VM.CurrentUserId.HasValue)
            {
                <button class="btn-favorite @(VM.IsFavorite ? "active" : "")" @onclick="VM.ToggleFavorite">
                    @(VM.IsFavorite ? "❤ Retirer des favoris" : "🤍 Ajouter aux favoris")
                </button>
            }
            else
            {
                <button class="btn-favorite" @onclick='() => Navigation.NavigateTo("/connexion")'>
                    🤍 Connectez-vous pour ajouter aux favoris
                </button>
            }
        </div>



        @if (VM.AnnonceSimilaires?.Any() == true)
        {
            <div class="similar-ads-section">
                <h2>🚗 Annonces similaires</h2>

                <div class="carousel-container">
                    <button class="carousel-nav prev" @onclick="VM.PreviousSimilar" disabled="@(!VM.CanGoPreviousSimilar)">
                        ◀
                    </button>

                    <div class="carousel-track">
                        <div class="carousel-inner" style="transform: @VM.GetCarouselTransform(); display: flex; gap: 20px; transition: transform 0.4s ease-in-out;">
                            @foreach (var annonce in VM.GetVisibleSimilarAds())
                            {
                                <div class="similar-ad-card" @onclick="() => VM.NavigateToSimilarAd(annonce.IdAnnonce)">
                                    <div class="similar-ad-image">
                                        <img src="@VM.GetSimilarAdImage(annonce.IdVoiture)"
                                             alt="@annonce.Marque @annonce.Modele"
                                             onerror="this.src='https://via.placeholder.com/300x200?text=Pas+d%27image'" />
                                    </div>

                                    <div class="similar-ad-content">
                                        <h3 class="similar-ad-title">@annonce.Libelle</h3>

                                        <div class="similar-ad-specs">
                                            <div class="spec-badge">
                                                <span class="spec-icon">📅</span>
                                                <span>@annonce.Annee</span>
                                            </div>
                                            <div class="spec-badge">
                                                <span class="spec-icon">📊</span>
                                                <span>@annonce.Kilometrage.ToString("N0") km</span>
                                            </div>
                                        </div>

                                        <div class="similar-ad-price">
                                            @if (annonce.Prix.HasValue)
                                            {
                                                <span>@annonce.Prix.Value.ToString("N0") €</span>
                                            }
                                            else
                                            {
                                                <span class="price-contact">Prix sur demande</span>
                                            }
                                        </div>

                                        <div class="similar-ad-location">
                                            📍 @annonce.Ville (@annonce.CodePostal)
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <button class="carousel-nav next" @onclick="VM.NextSimilar" disabled="@(!VM.CanGoNextSimilar)">
                        ▶
                    </button>
                </div>

                @if (VM.TotalSimilarPages > 1)
                {
                    <div class="carousel-dots">
                        @for (int i = 0; i < VM.TotalSimilarPages; i++)
                        {
                            var pageIndex = i;
                            <button class="carousel-dot @(VM.CurrentSimilarPage == pageIndex ? "active" : "")"
                                    @onclick="() => VM.GoToSimilarPage(pageIndex)"
                                    title="Position @(pageIndex + 1)">
                            </button>
                        }
                    </div>
                }
            </div>
        }





        @if (!string.IsNullOrEmpty(VM.erreurSupprimeAnnonce))
        {
            <div class="error-message-box">
                @VM.erreurSupprimeAnnonce
            </div>
        }
        <SignalementModal VM="@SignalementVM" genreSignalement="annonce"/>
    </div>
}

@code {
    [Parameter] public int IdAnnonce { get; set; }
    private string infoMasquer = "Masquer temporairement votre annonce pour que personne ne la vois sans la supprimer";
    private string infoDemasquer = "Demasquer cette annonce pour que les gens puisse la chercher";
    private string infoModif = "Modifier les caractéristiques de votre annonce";
    private string infoSupprimer = "Supprimer définitivement votre annonce";
    private string infoSignaler = "Signaler cette annonce pour contenu inapproprié ou frauduleux";

    protected override async Task OnInitializedAsync()
    {
        VM.Reset();
        await VM.InitializeAsync(IdAnnonce, StateHasChanged, JSRuntime, Navigation);
        await SignalementVM.InitializeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        await VM.DisposeAsync();
    }
}