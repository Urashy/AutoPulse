@page "/modifier-annonce/{IdAnnonce:int}"
@using BlazorAutoPulse.ViewModel
@inject GetAllViewModel VMAll
@inject ModifierAnnonceViewModel VM
@inject NavigationManager Navigation

<PageTitle>Modifier l'annonce - AutoPulse</PageTitle>

@* Composant Modal Paiement *@
@if (VM.Annonce != null)
{
    <PaiementModal
        IsVisible="@VM.showPaiementMavModal"
        IdCb="@((int value) => VM.SetIdCb(value))"
        Id="@VM.Annonce.IdMiseEnAvant"
        IsVisibleChanged="@((bool value) => VM.showPaiementMavModal = value)"
        OnPaymentSuccess="@VM.OnPaymentSuccess" />
}
@if (VM.IsLoading)
{
    <div class="loading-container">
        <div class="loader"></div>
        <p>Chargement de l'annonce...</p>
    </div>
}
else if (VM.Annonce == null)
{
    <div class="error-container">
        <h2>Annonce introuvable</h2>
        <p>L'annonce que vous souhaitez modifier n'existe pas ou vous n'avez pas les droits nécessaires.</p>
        <button @onclick="() => Redirect(homeUrl)" class="btn-back">Retour à l'accueil</button>
    </div>
}
else
{
    <div class="edit-container">
        <div class="header-nav">
            <button @onclick="() => Redirect(annonceUrl)" class="btn-back">← Annuler</button>
            <h1>Modifier l'annonce</h1>
        </div>

        <div class="edit-form">
            @if (VM.showErrors && VM.errors.ContainsKey("general"))
            {
                <div class="error-message-global">
                    @VM.GetError("general")
                </div>
            }

            <!-- SECTION ANNONCE -->
            <div class="section-header">
                <h2>📢 Informations de l'annonce</h2>
            </div>

            <div class="form-group @(VM.HasError("titre") ? "has-error" : "")">
                <label>Titre de l'annonce *</label>
                <input type="text" @bind="VM.Annonce.Libelle" placeholder="Titre de votre annonce" maxlength="200" />
                @if (VM.HasError("titre"))
                {
                    <span class="error-message">@VM.GetError("titre")</span>
                }
            </div>

            <div class="form-group @(VM.HasError("prix") ? "has-error" : "")">
                <label>Prix (€) *</label>
                <input type="number" @bind="VM.Annonce.Prix" placeholder="25000" min="0" />
                @if (VM.HasError("prix"))
                {
                    <span class="error-message">@VM.GetError("prix")</span>
                }
            </div>

            <div class="form-group @(VM.HasError("description") ? "has-error" : "")">
                <label>Description</label>
                <textarea @bind="VM.Annonce.Description" 
                          placeholder="Décrivez votre véhicule, son état, ses équipements..."
                          rows="8"></textarea>
                @if (VM.HasError("description"))
                {
                    <span class="error-message">@VM.GetError("description")</span>
                }
            </div>

            <div class="section-header">
                <h2>📸 Photos du véhicule</h2>
            </div>

            <div class="form-group @(VM.HasError("photos") ? "has-error" : "")">
                @if (VM.TotalImageCount == 0)
                {
                    <label for="vehiclePhotos" class="file-upload" style="cursor: pointer; display: block;">
                        <div style="font-size: 48px; margin-bottom: 20px;">📸</div>
                        <p style="color: #aaa;">Cliquez pour ajouter des photos</p>
                        <p style="color: #666; font-size: 14px; margin-top: 10px;">JPG, PNG - Max 10 photos de 10 MB chacune</p>
                    </label>
                    <InputFile id="vehiclePhotos" OnChange="@VM.UploadImage" multiple style="display:none"/>
                }
                else
                {
                    <!-- Carrousel d'images -->
                    <div class="images-carousel-section">
                        <!-- Image principale -->
                        <div class="main-image-carousel">
                            @if (!string.IsNullOrEmpty(VM.GetCurrentImageUrl()))
                            {
                                <img src="@VM.GetCurrentImageUrl()" alt="Photo @(VM.CurrentImageIndex + 1)" />

                                <!-- Bouton supprimer -->
                                <button type="button"
                                        class="btn-delete-image"
                                        @onclick="VM.RemoveCurrentImage"
                                        title="Supprimer cette photo">
                                    🗑️
                                </button>

                                <!-- Badge numéro de photo -->
                                <div class="image-badge">
                                    Photo @(VM.CurrentImageIndex + 1) / @VM.TotalImageCount
                                    @if (VM.CurrentImageIndex == 0)
                                    {
                                        <span class="cover-badge">📌 Couverture</span>
                                    }
                                    @if (VM.IsExistingImage(VM.CurrentImageIndex))
                                    {
                                        <span style="background: rgba(0, 212, 255, 0.2); padding: 4px 12px; border-radius: 15px; font-size: 12px; margin-left: 8px;">
                                            Actuelle
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="background: rgba(46, 213, 115, 0.2); padding: 4px 12px; border-radius: 15px; font-size: 12px; margin-left: 8px;">
                                            Nouvelle
                                        </span>
                                    }
                                </div>
                            }
                            else
                            {
                                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: #aaa;">
                                    <div class="loader" style="width: 40px; height: 40px; margin-bottom: 15px;"></div>
                                    <p>Chargement de l'image...</p>
                                </div>
                            }
                        </div>

                        <!-- Navigation -->
                        @if (VM.TotalImageCount > 1)
                        {
                            <div class="image-navigation-carousel">
                                <button type="button"
                                        @onclick="VM.PreviousImage"
                                        class="nav-btn"
                                        disabled="@(!VM.CanGoPrevious)">
                                    ◀
                                </button>
                                <div class="image-counter">
                                    @(VM.CurrentImageIndex + 1) / @VM.TotalImageCount
                                </div>
                                <button type="button"
                                        @onclick="VM.NextImage"
                                        class="nav-btn"
                                        disabled="@(!VM.CanGoNext)">
                                    ▶
                                </button>
                            </div>

                            <!-- Miniatures -->
                            <div class="thumbnails-carousel">
                                @for (int i = 0; i < VM.TotalImageCount; i++)
                                {
                                    var index = i;
                                    var thumbnailUrl = VM.GetThumbnailUrl(index);
                                    var isExisting = VM.IsExistingImage(index);

                                    <div class="thumbnail-carousel @(index == VM.CurrentImageIndex ? "active" : "")"
                                         @onclick="() => VM.SelectImage(index)">

                                        @if (!string.IsNullOrEmpty(thumbnailUrl))
                                        {
                                            <img src="@thumbnailUrl" alt="Miniature @(index + 1)" />

                                            @if (index == 0)
                                            {
                                                <div class="thumbnail-cover-indicator">📌</div>
                                            }

                                            @if (!isExisting)
                                            {
                                                <div style="position: absolute; top: 5px; right: 30px; background: rgba(46, 213, 115, 0.9); padding: 2px 6px; border-radius: 8px; font-size: 9px; font-weight: bold; color: #fff; z-index: 2;">
                                                    NEW
                                                </div>
                                            }

                                            <button type="button"
                                                    class="btn-delete-thumbnail"
                                                    @onclick="() => VM.RemoveImage(index)"
                                                    @onclick:stopPropagation="true"
                                                    title="Supprimer">
                                                ✕
                                            </button>
                                        }
                                        else
                                        {
                                            <div style="display: flex; align-items: center; justify-content: center; height: 100%;">
                                                <div class="loader" style="width: 20px; height: 20px;"></div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        <!-- Bouton ajouter plus de photos -->
                        @if (VM.TotalImageCount < 10)
                        {
                            <label for="vehiclePhotos" class="btn-add-more-photos">
                                <span class="add-icon">➕</span>
                                Ajouter d'autres photos (@VM.TotalImageCount / 10)
                            </label>
                            <InputFile id="vehiclePhotos" OnChange="@VM.UploadImage" multiple style="display:none"/>
                        }
                    </div>
                }

                @if (VM.HasError("photos"))
                {
                    <span class="error-message">@VM.GetError("photos")</span>
                }
            </div>

            <!-- SECTION VOITURE -->
            <div class="section-header">
                <h2>🚗 Caractéristiques du véhicule</h2>
            </div>

            <div class="form-row">
                <div class="form-group @(VM.HasError("kilometrage") ? "has-error" : "")">
                    <label>Kilométrage (km) *</label>
                    <input type="number" @bind="VM.Voiture.Kilometrage" placeholder="50000" min="0" />
                    @if (VM.HasError("kilometrage"))
                    {
                        <span class="error-message">@VM.GetError("kilometrage")</span>
                    }
                </div>

                <div class="form-group @(VM.HasError("annee") ? "has-error" : "")">
                    <label>Année *</label>
                    <input type="number" @bind="VM.Voiture.Annee" placeholder="2020" min="1900" max="@DateTime.Now.Year" />
                    @if (VM.HasError("annee"))
                    {
                        <span class="error-message">@VM.GetError("annee")</span>
                    }
                </div>
            </div>

            <div class="form-group @(VM.HasError("miseEnCirculation") ? "has-error" : "")">
                <label>Date de mise en circulation *</label>
                <input type="date" @bind="VM.Voiture.MiseEnCirculation" />
                @if (VM.HasError("miseEnCirculation"))
                {
                    <span class="error-message">@VM.GetError("miseEnCirculation")</span>
                }
            </div>

            <div class="form-row">
                <div class="form-group @(VM.HasError("puissance") ? "has-error" : "")">
                    <label>Puissance (ch) *</label>
                    <input type="number" @bind="VM.Voiture.Puissance" placeholder="150" min="0" />
                    @if (VM.HasError("puissance"))
                    {
                        <span class="error-message">@VM.GetError("puissance")</span>
                    }
                </div>

                <div class="form-group @(VM.HasError("couple") ? "has-error" : "")">
                    <label>Couple (Nm) *</label>
                    <input type="number" @bind="VM.Voiture.Couple" placeholder="250" min="0" />
                    @if (VM.HasError("couple"))
                    {
                        <span class="error-message">@VM.GetError("couple")</span>
                    }
                </div>
            </div>

            <div class="form-row">
                <div class="form-group @(VM.HasError("nbCylindres") ? "has-error" : "")">
                    <label>Nombre de cylindres *</label>
                    <input type="number" @bind="VM.Voiture.NbCylindres" placeholder="4" min="1" max="16" />
                    @if (VM.HasError("nbCylindres"))
                    {
                        <span class="error-message">@VM.GetError("nbCylindres")</span>
                    }
                </div>

                <div class="form-group @(VM.HasError("cylindrerMoteur") ? "has-error" : "")">
                    <label>Cylindrée (L) *</label>
                    <input type="number" step="0.1" @bind="VM.Voiture.CylindrerMoteur" placeholder="2.0" min="0" />
                    @if (VM.HasError("cylindrerMoteur"))
                    {
                        <span class="error-message">@VM.GetError("cylindrerMoteur")</span>
                    }
                </div>
            </div>

            <div class="form-row">
                <div class="form-group @(VM.HasError("nbPlaces") ? "has-error" : "")">
                    <label>Nombre de places *</label>
                    <input type="number" @bind="VM.Voiture.NbPlace" placeholder="5" min="1" max="9" />
                    @if (VM.HasError("nbPlaces"))
                    {
                        <span class="error-message">@VM.GetError("nbPlaces")</span>
                    }
                </div>

                <div class="form-group @(VM.HasError("nbPortes") ? "has-error" : "")">
                    <label>Nombre de portes *</label>
                    <input type="number" @bind="VM.Voiture.NbPorte" placeholder="5" min="2" max="7" />
                    @if (VM.HasError("nbPortes"))
                    {
                        <span class="error-message">@VM.GetError("nbPortes")</span>
                    }
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Intérieur en cuir</label>
                    <div class="checkbox-group">
                        <input type="checkbox" id="interieurCuir" @bind="VM.Voiture.InterieurCuire" />
                        <label for="interieurCuir" class="checkbox-label">Oui</label>
                    </div>
                </div>

                <div class="form-group">
                    <label>Position du volant</label>
                    <div class="checkbox-group">
                        <input type="checkbox" id="positionVolant" @bind="VM.Voiture.PositionVolant" />
                        <label for="positionVolant" class="checkbox-label">
                            @(VM.Voiture.PositionVolant ? "À droite" : "À gauche")
                        </label>
                    </div>
                </div>
            </div>

            <div class="form-group  @(VM.HasError("couleurs") ? "has-error" : "")">
                <label>Mise en avant (effectif au prochain paiement si vous avez déja une mise en avant</label>
                <select @bind="@VM.selectedMavId">
                    <option value="0">Toutes les mise en avant</option>
                    @if (VMAll.allMiseEnAvant != null)
                    {
                        @foreach (var miseEnAvant in VMAll.allMiseEnAvant)
                        {
                            <option value="@miseEnAvant.IdMiseEnAvant">@miseEnAvant.LibelleMiseEnAvant (@miseEnAvant.PrixSemaine€)</option>
                        }
                    }
                </select>
                @if (VM.HasError("miseEnAvant"))
                {
                    <span class="error-message">@VM.GetError("miseEnAvant")</span>
                }
            </div>

            <!-- Boutons d'action -->
            <div class="form-actions">
                <button @onclick="() => Redirect(annonceUrl)" class="btn-cancel-action">
                    Annuler
                </button>
                <button @onclick="VM.SaveChangeOrUpdateCB" class="btn-save" disabled="@VM.IsSaving">
                    @(VM.IsSaving ? "Enregistrement..." : "💾 Enregistrer les modifications")
                </button>
            </div>

            @if (!string.IsNullOrEmpty(VM.successMessage))
            {
                <div class="success-message">
                    ✓ @VM.successMessage
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int IdAnnonce { get; set; }

    public string annonceUrl => $"/annonce/{IdAnnonce}";
    public string homeUrl => "/";

    protected override async Task OnInitializedAsync()
    {
        await VMAll.InitializeAsync();
        await VM.InitializeAsync(IdAnnonce, StateHasChanged, Navigation);
    }

    private void Redirect(string uri)
    {
        Navigation.NavigateTo(uri);
    }
}