@page "/connexion"
@using BlazorAutoPulse.ViewModel
@inject ConnexionViewModel VM
@inject NavigationManager nav

<div id="login" class="page">
    <div class="auth-container">
        <div class="auth-box">
            <h2>Connexion</h2>

            @if (!string.IsNullOrEmpty(VM.messageErreur))
            {
                <div class="error-message-box">
                    @VM.messageErreur
                </div>
            }

            @if (!VM.requiresA2f)
            {
                <!-- Formulaire classique -->
                <form>
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email"
                               placeholder="votre@email.com"
                               @bind="VM.emailUtilisateur"
                               disabled="@VM.isLoading"
                               required>
                    </div>
                    <div class="form-group">
                        <label>Mot de passe</label>
                        <input type="password"
                               placeholder="••••••••"
                               @bind="VM.motDePasseUtilisateur"
                               disabled="@VM.isLoading"
                               required>
                    </div>
                    <button type="button"
                            class="btn-submit"
                            @onclick="VM.ConnexionUtilisateur"
                            disabled="@VM.isLoading">
                        @if (VM.isLoading)
                        {
                            <span>Connexion en cours...</span>
                        }
                        else
                        {
                            <span>Se connecter</span>
                        }
                    </button>
                </form>

                <!-- Séparateur -->
                <div class="separator">
                    <span>OU</span>
                </div>

                <!-- Bouton Google -->
                <button type="button"
                        class="btn-google"
                        @onclick="VM.ConnecterAvecGoogle"
                        disabled="@VM.isLoading">
                    <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google logo" />
                    <span>Continuer avec Google</span>
                </button>

                <div class="auth-switch">
                    <div>Pas encore de compte ? <a href="creationcompte">S'inscrire</a></div>
                    <a href="oublimdp">Mot de passe oublié?</a>
                </div>
            }
            else
            {
                <!-- Formulaire A2F -->
                <div class="a2f-container">
                    @if (VM.mustReactivateA2f)
                    {
                        <div class="info-box warning">
                            <span class="info-icon">⚠️</span>
                            <div>
                                <h4>Réactivation A2F requise</h4>
                                <p>Votre authentification à deux facteurs doit être réactivée pour des raisons de sécurité.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="info-box">
                            <span class="info-icon">🔒</span>
                            <div>
                                <h4>Code de vérification</h4>
                                <p>Un code a été envoyé à votre adresse email.</p>
                            </div>
                        </div>
                    }

                    <form>
                        <div class="form-group">
                            <label>Code de vérification</label>
                            <input type="text"
                                   placeholder="1234567"
                                   @bind="VM.codeA2f"
                                   disabled="@VM.isLoading"
                                   maxlength="7"
                                   class="code-input"
                                   required>
                        </div>

                        <button type="button"
                                class="btn-submit"
                                @onclick="VM.ValiderCodeA2f"
                                disabled="@VM.isLoading">
                            @if (VM.isLoading)
                            {
                                <span>Vérification...</span>
                            }
                            else
                            {
                                <span>Valider le code</span>
                            }
                        </button>
                    </form>

                    <div class="a2f-actions">
                        <button type="button"
                                class="btn-link"
                                @onclick="VM.RenvoyerCodeA2f"
                                disabled="@VM.isLoading">
                            Renvoyer le code
                        </button>
                        <button type="button"
                                class="btn-link"
                                @onclick="VM.Reset">
                            Retour à la connexion
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        VM.Reset();
        await VM.InitializeAsync(StateHasChanged, nav);
    }
}