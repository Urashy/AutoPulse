@page "/connexion"
@using BlazorAutoPulse.ViewModel
@inject ConnexionViewModel VM
@inject NavigationManager nav

<div id="login" class="page">
    <div class="auth-container">
        <div class="auth-box">
            <h2>Connexion</h2>

            @if (!string.IsNullOrEmpty(VM.messageErreur))
            {
                <div class="error-message-box" data-testid='error-box'>
                    @VM.messageErreur
                </div>
            }

            @if (!VM.requiresA2f)
            {
                <!-- Formulaire classique -->
                <form>
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email"
                               data-testid='email-connexion'
                               placeholder="votre@email.com"
                               @bind="VM.emailUtilisateur"
                               disabled="@VM.isLoading"
                               required>
                    </div>
                    <div class="form-group">
                        <label>Mot de passe</label>
                        <input type="password"
                               data-testid='password-connexion'
                               placeholder="••••••••"
                               @bind="VM.motDePasseUtilisateur"
                               disabled="@VM.isLoading"
                               required>
                    </div>

                    <div class="remember-me">
                        <label class="checkbox-container">
                            <input type="checkbox"
                                   @bind="VM.rememberMe"
                                   disabled="@VM.isLoading" />
                            <span class="checkmark"></span>
                            <span class="checkbox-label">Se souvenir de moi pendant 30 jours</span>
                        </label>
                        <div class="remember-info">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                            </svg>
                            <span>Décoché : déconnexion à la fermeture du navigateur</span>
                        </div>
                    </div>

                    <button type="button"
                            data-testid='btn-connexion'
                            class="btn-submit"
                            @onclick="VM.ConnexionUtilisateur"
                            disabled="@VM.isLoading">
                        @if (VM.isLoading)
                        {
                            <span>Connexion en cours...</span>
                        }
                        else
                        {
                            <span>Se connecter</span>
                        }
                    </button>
                </form>

                <!-- Séparateur -->
                <div class="separator">
                    <span>OU</span>
                </div>

                <!-- Bouton Google -->
                <button type="button"
                        class="btn-google"
                        @onclick="VM.ConnecterAvecGoogle"
                        disabled="@VM.isLoading">
                    <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google logo" />
                    <span>Continuer avec Google</span>
                </button>

                <div class="auth-switch">
                    <div>Pas encore de compte ? <a href="creationcompte" data-testid='btn-inscription'>S'inscrire</a></div>
                    <a href="oublimdp">Mot de passe oublié?</a>
                </div>
            }
            else
            {
                <!-- Formulaire A2F -->
                <div class="a2f-container">
                    @if (VM.mustReactivateA2f || VM.requiresA2f)
                    {
                        <div class="info-box warning">
                            <span class="info-icon">⚠️</span>
                            <div>
                                <h4>Réactivation A2F requise</h4>
                                <p>Votre authentification à deux facteurs doit être réactivée pour des raisons de sécurité.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="info-box">
                            <span class="info-icon">🔒</span>
                            <div>
                                <h4>Code de vérification</h4>
                                <p>Un code a été envoyé à votre adresse email.</p>
                            </div>
                        </div>
                    }

                    <!-- ✅ Affichage du statut "Se souvenir de moi" -->
                    @if (VM.rememberMe)
                    {
                        <div class="session-info">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/>
                            </svg>
                            <span>Session de 30 jours activée</span>
                        </div>
                    }

                    <form>
                        <div class="form-group">
                            <label>Code de vérification</label>
                            <input type="text"
                                   placeholder="1234567"
                                   @bind="VM.codeA2f"
                                   disabled="@VM.isLoading"
                                   maxlength="7"
                                   class="code-input"
                                   required>
                        </div>

                        <button type="button"
                                class="btn-submit"
                                @onclick="VM.ValiderCodeA2f"
                                disabled="@VM.isLoading">
                            @if (VM.isLoading)
                            {
                                <span>Vérification...</span>
                            }
                            else
                            {
                                <span>Valider le code</span>
                            }
                        </button>
                    </form>

                    <div class="a2f-actions">
                        <button type="button"
                                class="btn-link"
                                @onclick="VM.RenvoyerCodeA2f"
                                disabled="@VM.isLoading">
                            Renvoyer le code
                        </button>
                        <button type="button"
                                class="btn-link"
                                @onclick="VM.Reset">
                            Retour à la connexion
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        VM.Reset();
        await VM.InitializeAsync(StateHasChanged, nav);
    }
}