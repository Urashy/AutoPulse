@page "/admin/annonces"
@layout AdminLayout
@using BlazorAutoPulse.ViewModel.Administration
@using BlazorAutoPulse.Composant
@inject AdminAnnoncesViewModel VM

<PageTitle>Gestion des annonces - Admin</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <h1>🚗 Gestion des annonces</h1>
        <input type="text"
               placeholder="🔍 Rechercher..."
               @bind="VM.SearchQuery"
               @bind:event="oninput"
               @onkeyup="VM.SearchAnnonces"
               class="search-input"
               style="max-width: 300px; padding: 8px; border-radius: 5px; border: 1px solid #ddd;">
    </div>

    @if (VM.IsLoading)
    {
        <p>Chargement...</p>
    }
    else
    {
        <div class="annonces-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; padding: 20px 0;">
            @foreach (var annonce in VM.GetPagedAnnonces())
            {
                <div class="admin-annonce-wrapper" style="position: relative; display: flex; flex-direction: column;">

                    <AnnonceComposant Annonce="@annonce" />

                    <button class="btn btn-danger"
                            style="margin-top: 10px; width: 100%;"
                            @onclick="@(() => VM.DeleteAnnonce(annonce))">
                        🗑️ Supprimer
                    </button>

                    @* @if(annonce.Prix < 5000) { 
                        <div style="background: red; color: white; padding: 5px; text-align: center; margin-top: 5px;">⚠️ SUSPECT</div> 
                    } 
                    *@
                </div>
            }
        </div>

        @if (VM.TotalPages > 1)
        {
            <div class="pagination" style="display: flex; justify-content: center; gap: 15px; margin-top: 20px; align-items: center;">
                <button class="btn btn-secondary" @onclick="VM.PreviousPage" disabled="@(!VM.CanGoPrevious)">←</button>
                <span>@VM.PaginationInfo</span>
                <button class="btn btn-secondary" @onclick="VM.NextPage" disabled="@(!VM.CanGoNext)">→</button>
            </div>
        }
    }
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await VM.InitializeAsync(StateHasChanged);
    }
}