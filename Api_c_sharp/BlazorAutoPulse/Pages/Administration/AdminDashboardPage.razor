@page "/admin"
@layout AdminLayout
@using BlazorAutoPulse.ViewModel.Administration
@inject AdminDashboardViewModel VM
@inject NavigationManager Navigation

<PageTitle>Tableau de bord Admin - AutoPulse</PageTitle>

<div class="admin-dashboard">
    <div class="dashboard-header">
        <h1>📊 Tableau de bord</h1>
        <p class="subtitle">Vue d'ensemble de la plateforme</p>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon revenue">🚗</div>
            <div class="stat-info">
                <h3>@VM.TotalAnnonces</h3>
                <p>Annonces</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon users">👥</div>
            <div class="stat-info">
                <h3>@VM.TotalUtilisateurs</h3>
                <p>Comptes</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon signalements">🚩</div>
            <div class="stat-info">
                <h3>@VM.SignalementsEnAttente</h3>
                <p>Signalements (Attente)</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon warning">⚖️</div>
            <div class="stat-info">
                <h3>@VM.TotalPlaintes</h3>
                <p>Plaintes</p>
            </div>
        </div>
    </div>

    <div class="dashboard-content">
        <div class="recent-activity">
            <div class="section-header">
                <h2>📋 Derniers Signalements</h2>
                <button class="btn-refresh" @onclick="VM.RefreshData">Actualiser</button>
            </div>

            <div class="activity-list">
                @if (VM.SignalementsRecent != null && VM.SignalementsRecent.Any())
                {
                    @foreach (var s in VM.SignalementsRecent)
                    {
                        <div class="activity-item">
                            <div class="activity-content">
                                <strong>@s.PseudoSignalant</strong> a signalé
                                @(string.IsNullOrEmpty(s.TitreCible) ? s.PseudoCible : s.TitreCible)
                                <br />
                                <small>@s.TypeSignalement - @s.DateSignalement.ToShortDateString()</small>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p>Aucune activité récente.</p>
                }
            </div>
        </div>

        <div class="quick-actions">
            <h2>⚡ Gestion</h2>
            <div class="actions-grid">
                <button class="action-btn" @onclick='() => Navigation.NavigateTo("/admin/annonces")'>
                    Gérer les annonces
                </button>
                <button class="action-btn" @onclick='() => Navigation.NavigateTo("/admin/utilisateurs")'>
                    Gérer les utilisateurs
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await VM.InitializeAsync(StateHasChanged);
    }
}