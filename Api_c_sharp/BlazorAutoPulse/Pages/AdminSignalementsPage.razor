@page "/admin/signalements"
@layout AdminLayout
@using BlazorAutoPulse.ViewModel
@inject AdminSignalementsViewModel VM

<PageTitle>Gestion des signalements - Admin</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <div class="header-left">
            <h1>🚩 Gestion des signalements</h1>
            <p class="subtitle">@VM.TotalSignalements signalement(s) au total</p>
        </div>
        <div class="header-actions">
            <input type="text"
                   placeholder="🔍 Rechercher..."
                   @bind="VM.SearchQuery"
                   @bind:event="oninput"
                   @onkeyup="VM.SearchSignalements"
                   class="search-input">
        </div>
    </div>

    <div class="filters-bar">
        <button class="filter-btn @(VM.FilterType == "all" ? "active" : "")"
                @onclick="@(() => VM.FilterByType("all"))">
            Tous (@VM.TotalSignalements)
        </button>
        <button class="filter-btn @(VM.FilterType == "annonce" ? "active" : "")"
                @onclick="@(() => VM.FilterByType("annonce"))">
            Annonces (@VM.SignalementsAnnonces)
        </button>
        <button class="filter-btn @(VM.FilterType == "compte" ? "active" : "")"
                @onclick="@(() => VM.FilterByType("compte"))">
            Comptes (@VM.SignalementsComptes)
        </button>
        <div style="margin-left: auto; display: flex; gap: 10px;">
            <button class="filter-btn @(VM.FilterStatus == "pending" ? "active" : "")"
                    @onclick="@(() => VM.FilterByStatus("pending"))">
                En attente (@VM.SignalementsEnAttente)
            </button>
            <button class="filter-btn @(VM.FilterStatus == "resolved" ? "active" : "")"
                    @onclick="@(() => VM.FilterByStatus("resolved"))">
                Traités (@VM.SignalementsTraites)
            </button>
            <button class="filter-btn @(VM.FilterStatus == "rejected" ? "active" : "")"
                    @onclick="@(() => VM.FilterByStatus("rejected"))">
                Rejetés (@VM.SignalementsRejetes)
            </button>
        </div>
    </div>

    @if (VM.IsLoading)
    {
        <div class="loading-state">
            <div class="loader"></div>
            <p>Chargement des signalements...</p>
        </div>
    }
    else
    {
        <div class="signalements-grid">
            @foreach (var signalement in VM.GetPagedSignalements())
            {
                <div class="signalement-card @GetCardClass(signalement)">
                    <div class="signalement-header">
                        <div class="signalement-type">
                            <span class="type-icon">@GetTypeIcon(signalement)</span>
                            <span class="type-text">@signalement.TypeSignalement</span>
                        </div>
                        <span class="signalement-badge badge-@signalement.Statut.ToLower()">
                            @signalement.Statut
                        </span>
                    </div>

                    <div class="signalement-content">
                        <div class="signalement-info">
                            <div class="info-row">
                                <span class="info-label">Signalé par:</span>
                                <span class="info-value">@signalement.PseudoSignalant</span>
                            </div>
                            @if (signalement.TypeCible == "Annonce")
                            {
                                <div class="info-row">
                                    <span class="info-label">Annonce:</span>
                                    <span class="info-value">@signalement.TitreCible</span>
                                </div>
                            }
                            else
                            {
                                <div class="info-row">
                                    <span class="info-label">Compte signalé:</span>
                                    <span class="info-value">@signalement.PseudoCible</span>
                                </div>
                            }
                            <div class="info-row">
                                <span class="info-label">Date:</span>
                                <span class="info-value">@signalement.DateSignalement.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(signalement.Description))
                        {
                            <div class="signalement-description">
                                <p class="description-label">Description:</p>
                                <p class="description-text">@signalement.Description</p>
                            </div>
                        }
                    </div>

                    @if (signalement.Statut == "En attente")
                    {
                        <div class="signalement-actions">
                            <button class="btn-action primary"
                                    @onclick="() => VM.ViewDetails(signalement)"
                                    title="Voir détails">
                                👁️ Voir
                            </button>
                            <button class="btn-action success"
                                    @onclick="() => VM.AcceptSignalement(signalement)"
                                    title="Accepter et agir">
                                ✅ Accepter
                            </button>
                            <button class="btn-action danger"
                                    @onclick="() => VM.RejectSignalement(signalement)"
                                    title="Rejeter">
                                ❌ Rejeter
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="signalement-actions">
                            <button class="btn-action primary"
                                    @onclick="() => VM.ViewDetails(signalement)"
                                    title="Voir détails">
                                👁️ Voir détails
                            </button>
                        </div>
                    }
                </div>
            }
        </div>

        @if (VM.TotalPages > 1)
        {
            <div class="pagination">
                <button class="btn-page"
                        @onclick="VM.PreviousPage"
                        disabled="@(!VM.CanGoPrevious)">
                    ← Précédent
                </button>
                <span class="page-info">
                    Page @VM.CurrentPage sur @VM.TotalPages
                </span>
                <button class="btn-page"
                        @onclick="VM.NextPage"
                        disabled="@(!VM.CanGoNext)">
                    Suivant →
                </button>
            </div>
        }
    }
</div>

<!-- Modal de confirmation d'action -->
@if (VM.ShowActionModal)
{
    <div class="modal-overlay" @onclick="VM.CloseActionModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>⚠️ Confirmation</h2>
                <button class="modal-close" @onclick="VM.CloseActionModal">✕</button>
            </div>
            <div class="modal-body">
                <p class="modal-message">@VM.ActionMessage</p>

                @if (VM.ActionType == "accept" && VM.SelectedSignalement?.TypeCible == "Annonce")
                {
                    <div class="action-options">
                        <label class="action-option">
                            <input type="radio"
                                   name="action"
                                   value="delete"
                                   @onchange="@(() => VM.SetAction("delete"))"
                                   checked="@(VM.SelectedAction == "delete")" />
                            <span>🗑️ Supprimer l'annonce</span>
                        </label>
                        <label class="action-option">
                            <input type="radio"
                                   name="action"
                                   value="suspend"
                                   @onchange="@(() => VM.SetAction("suspend"))"
                                   checked="@(VM.SelectedAction == "suspend")" />
                            <span>🔒 Suspendre l'annonce</span>
                        </label>
                    </div>
                }

                @if (VM.ActionType == "accept" && VM.SelectedSignalement?.TypeCible == "Compte")
                {
                    <div class="action-options">
                        <label class="action-option">
                            <input type="radio"
                                   name="action"
                                   value="anonymize"
                                   @onchange="@(() => VM.SetAction("anonymize"))"
                                   checked="@(VM.SelectedAction == "anonymize")" />
                            <span>👤 Anonymiser le compte</span>
                        </label>
                        <label class="action-option">
                            <input type="radio"
                                   name="action"
                                   value="suspend"
                                   @onchange="@(() => VM.SetAction("suspend"))"
                                   checked="@(VM.SelectedAction == "suspend")" />
                            <span>🔒 Suspendre le compte</span>
                        </label>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-secondary" @onclick="VM.CloseActionModal">
                    Annuler
                </button>
                <button class="btn-danger" @onclick="VM.ConfirmAction">
                    Confirmer
                </button>
            </div>
        </div>
    </div>
}

<!-- Modal de détails -->
@if (VM.ShowDetailsModal && VM.SelectedSignalement != null)
{
    <div class="modal-overlay" @onclick="VM.CloseDetailsModal">
        <div class="modal-content modal-large" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>📋 Détails du signalement</h2>
                <button class="modal-close" @onclick="VM.CloseDetailsModal">✕</button>
            </div>
            <div class="modal-body">
                <div class="details-grid">
                    <div class="detail-section">
                        <h3>Informations générales</h3>
                        <div class="detail-row">
                            <span class="detail-label">Type:</span>
                            <span class="detail-value">@VM.SelectedSignalement.TypeSignalement</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Statut:</span>
                            <span class="detail-value">
                                <span class="badge badge-@VM.SelectedSignalement.Statut.ToLower()">
                                    @VM.SelectedSignalement.Statut
                                </span>
                            </span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Date:</span>
                            <span class="detail-value">@VM.SelectedSignalement.DateSignalement.ToString("dd/MM/yyyy à HH:mm")</span>
                        </div>
                    </div>

                    <div class="detail-section">
                        <h3>Signalant</h3>
                        <div class="detail-row">
                            <span class="detail-label">Pseudo:</span>
                            <span class="detail-value">@VM.SelectedSignalement.PseudoSignalant</span>
                        </div>
                    </div>

                    <div class="detail-section">
                        <h3>Cible du signalement</h3>
                        @if (VM.SelectedSignalement.TypeCible == "Annonce")
                        {
                            <div class="detail-row">
                                <span class="detail-label">Type:</span>
                                <span class="detail-value">Annonce</span>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">Titre:</span>
                                <span class="detail-value">@VM.SelectedSignalement.TitreCible</span>
                            </div>
                        }
                        else
                        {
                            <div class="detail-row">
                                <span class="detail-label">Type:</span>
                                <span class="detail-value">Compte utilisateur</span>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">Pseudo:</span>
                                <span class="detail-value">@VM.SelectedSignalement.PseudoCible</span>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(VM.SelectedSignalement.Description))
                    {
                        <div class="detail-section full-width">
                            <h3>Description</h3>
                            <p class="description-full">@VM.SelectedSignalement.Description</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<style>
    .signalements-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .signalement-card {
        background: #1a1a1a;
        border-radius: 12px;
        padding: 20px;
        border: 1px solid #333;
        transition: all 0.3s;
    }

    .signalement-card:hover {
        border-color: #00d4ff;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 212, 255, 0.1);
    }

    .signalement-card.urgent {
        border-color: #ff4444;
    }

    .signalement-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
        padding-bottom: 15px;
        border-bottom: 1px solid #333;
    }

    .signalement-type {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .type-icon {
        font-size: 24px;
    }

    .type-text {
        font-weight: 600;
        color: #fff;
    }

    .signalement-badge {
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
    }

    .badge-en.attente {
        background: #ffa500;
        color: #000;
    }

    .badge-traité {
        background: #4caf50;
        color: #fff;
    }

    .badge-rejeté {
        background: #666;
        color: #fff;
    }

    .signalement-content {
        margin-bottom: 15px;
    }

    .signalement-info {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .info-label {
        color: #888;
        font-size: 14px;
    }

    .info-value {
        color: #fff;
        font-weight: 500;
    }

    .signalement-description {
        margin-top: 15px;
        padding-top: 15px;
        border-top: 1px solid #333;
    }

    .description-label {
        color: #888;
        font-size: 14px;
        margin-bottom: 5px;
    }

    .description-text {
        color: #ccc;
        font-size: 14px;
        line-height: 1.5;
    }

    .signalement-actions {
        display: flex;
        gap: 10px;
        margin-top: 15px;
    }

    .btn-action {
        flex: 1;
        padding: 8px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.3s;
    }

    .btn-action.primary {
        background: #2196f3;
        color: #fff;
    }

    .btn-action.success {
        background: #4caf50;
        color: #fff;
    }

    .btn-action.danger {
        background: #ff4444;
        color: #fff;
    }

    .btn-action:hover {
        transform: translateY(-2px);
        opacity: 0.9;
    }

    .action-options {
        display: flex;
        flex-direction: column;
        gap: 15px;
        margin-top: 20px;
    }

    .action-option {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 15px;
        background: #1a1a1a;
        border: 2px solid #333;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
    }

    .action-option:hover {
        border-color: #00d4ff;
    }

    .action-option input[type="radio"] {
        width: 20px;
        height: 20px;
    }

    .action-option span {
        font-size: 16px;
        color: #fff;
    }

    .modal-message {
        font-size: 16px;
        color: #ccc;
        line-height: 1.6;
    }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .detail-section {
        background: #1a1a1a;
        padding: 20px;
        border-radius: 8px;
    }

    .detail-section.full-width {
        grid-column: 1 / -1;
    }

    .detail-section h3 {
        color: #00d4ff;
        margin-bottom: 15px;
        font-size: 16px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
    }

    .description-full {
        color: #ccc;
        line-height: 1.6;
        white-space: pre-wrap;
    }
</style>

@code {
    protected override async Task OnInitializedAsync()
    {
        await VM.InitializeAsync(StateHasChanged);
    }

    private string GetCardClass(AdminSignalement signalement)
    {
        return signalement.Statut == "En attente" &&
               (signalement.TypeSignalement.Contains("Violence") ||
                signalement.TypeSignalement.Contains("Illégal"))
            ? "urgent" : "";
    }

    private string GetTypeIcon(AdminSignalement signalement)
    {
        return signalement.TypeCible == "Annonce" ? "🚗" : "👤";
    }
}