@page "/creationcompte"
@using BlazorAutoPulse.ViewModel
@inject CreationCompteViewModel VM
@inject NavigationManager nav

<div class="popup-overlay" style="@(VM.showPopUp ? "display: flex" : "display: none")">
    <div class="popup">
        <h2>✅ Compte créé avec succès !</h2>
        <p>Un email de vérification a été envoyé à <strong>@VM.compte.Email</strong></p>
        <p>Veuillez vérifier votre boîte de réception et cliquer sur le lien de vérification.</p>
        <p class="small-text">Vous serez redirigé vers la page de connexion dans <strong>@VM.seconds</strong> seconde@(VM.seconds > 1 ? "s" : "").</p>
    </div>
</div>

<div class="auth-container">
    <div class="auth-box">
        <h2>Inscription</h2>
        <!-- Bouton Google en HAUT -->
        <button type="button"
                class="btn-google"
                @onclick="VM.ConnecterAvecGoogle">
            <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google logo" />
            <span>S'inscrire avec Google</span>
        </button>

        <!-- Séparateur -->
        <div class="separator">
            <span>OU</span>
        </div>

        @if (VM.compte != null)
        {
            <form>
                <div class="form-group">
                    <label>Prénom</label>
                    <input type="text" placeholder="Jean" @bind="VM.compte.Prenom" required>
                </div>
                <div class="form-group">
                    <label>Nom</label>
                    <input type="text" placeholder="Dupont" @bind="VM.compte.Nom" required>
                </div>
                <div class="form-group">
                    <label>Pseudo</label>
                    <input type="text" placeholder="XXX" @bind="VM.compte.Pseudo" required data-testid='pseudo-inscription'>
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" placeholder="votre@email.com" @bind="VM.compte.Email" required data-testid='email-inscription'/>
                </div>

                <!-- ✅ Mot de passe avec validation en temps réel -->
                <div class="form-group @(!VM.memeMotDePasse && !string.IsNullOrEmpty(VM.motDePasse) ? "error shake" : VM.memeMotDePasse && !string.IsNullOrEmpty(VM.motDePasse) && !string.IsNullOrEmpty(VM.compte.MotDePasse) ? "success" : "")">
                    <label>Mot de passe</label>
                    <input type="password"
                           placeholder="••••••••"
                           value="@VM.compte.MotDePasse"
                           @oninput="@((e) => OnPasswordChange(e.Value?.ToString()))"
                           required
                           data-testid='password-inscription'>
                </div>

                <!-- ✅ Confirmation mot de passe avec validation en temps réel -->
                <div class="form-group @(!VM.memeMotDePasse && !string.IsNullOrEmpty(VM.motDePasse) ? "error shake" : VM.memeMotDePasse && !string.IsNullOrEmpty(VM.motDePasse) && !string.IsNullOrEmpty(VM.compte.MotDePasse) ? "success" : "")">
                    <label>Confirmer le mot de passe</label>
                    <input type="password"
                           placeholder="••••••••"
                           value="@VM.motDePasse"
                           @oninput="@((e) => OnPasswordConfirmChange(e.Value?.ToString()))"
                           required
                           data-testid='password-confirmation-inscription'>
                    @if (!string.IsNullOrEmpty(VM.motDePasse) && !string.IsNullOrEmpty(VM.compte.MotDePasse))
                    {
                        <div class="password-match @(VM.memeMotDePasse ? "match" : "mismatch")">
                            @(VM.memeMotDePasse ? "✓ Les mots de passe correspondent" : "✗ Les mots de passe ne correspondent pas")
                        </div>
                    }
                </div>

                <div class="form-group">
                    <label>Date de naissance</label>
                    <input type="date" @bind="VM.compte.DateNaissance" required>
                </div>
                <div class="form-group">
                    <label>Biographie</label>
                    <input type="text" placeholder="XXXXXX" @bind="VM.compte.Biographie">
                </div>
                <div class="form-group" style="display: flex; align-items: center;">
                    <input @onchange="VM.ReloadPage" type="checkbox" id="is-pro-checkbox">
                    <label for="is-pro-checkbox" style="margin-bottom: 0; cursor: pointer;">
                        Je suis un professionnel
                    </label>
                </div>

                @if (VM.pro)
                {
                    <div class="form-group">
                        <label>Numéro de SIRET</label>
                        <input type="text" placeholder="123 456 789 00010" @bind="VM.compte.NumeroSiret">
                    </div>
                    <div class="form-group">
                        <label>Raison sociale</label>
                        <input type="text" placeholder="Google" @bind="VM.compte.RaisonSociale">
                    </div>
                }

                <button type="button" @onclick="VM.CreateCompteAsync" class="btn-submit" data-testid='btn-valide-inscription'>S'inscrire</button>

                @if (VM.messageErreur != null)
                {
                    <label class="error-message" data-testid='error-box'>@VM.messageErreur</label>
                }
            </form>
        }

        <div class="auth-switch">
            Déjà un compte ? <a href="connexion">Se connecter</a>
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await VM.InitializeAsync(StateHasChanged, nav);
    }

    // ✅ Validation en temps réel du mot de passe
    private void OnPasswordChange(string? value)
    {
        VM.compte.MotDePasse = value ?? string.Empty;
        VM.VerifierCorrespondanceMotDePasse();
        StateHasChanged();
    }

    // ✅ Validation en temps réel de la confirmation
    private void OnPasswordConfirmChange(string? value)
    {
        VM.motDePasse = value ?? string.Empty;
        VM.VerifierCorrespondanceMotDePasse();
        StateHasChanged();
    }
}