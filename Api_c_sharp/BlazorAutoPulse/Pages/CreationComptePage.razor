@page "/creationcompte"
@using BlazorAutoPulse.ViewModel
@inject CreationCompteViewModel VM
@inject NavigationManager nav

<div class="popup-overlay" style="@(VM.showPopUp ? "display: flex" : "display: none")">
    <div class="popup">
        <h2>Votre compte a été créé</h2>
        <p>Vous serez redirigé vers la page de connexion dans <strong>@VM.seconds</strong> secondes.</p>
    </div>
</div>

<div class="auth-container">
    <div class="auth-box">
        <h2>Inscription</h2>

        @if (!VM.afficherA2f)
        {
            <!-- ÉTAPE 1 : CRÉATION DU COMPTE -->
            
            <!-- Bouton Google en HAUT -->
            <button type="button" 
                    class="btn-google" 
                    @onclick="VM.ConnecterAvecGoogle">
                <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google logo" />
                <span>S'inscrire avec Google</span>
            </button>

            <!-- Séparateur -->
            <div class="separator">
                <span>OU</span>
            </div>

            @if (VM.compte != null)
            {
                <form>
                    <div class="form-group">
                        <label>Prénom</label>
                        <input type="text" placeholder="Jean" @bind="VM.compte.Prenom" required>
                    </div>
                    <div class="form-group">
                        <label>Nom</label>
                        <input type="text" placeholder="Dupont" @bind="VM.compte.Nom" required>
                    </div>
                    <div class="form-group">
                        <label>Pseudo</label>
                        <input type="text" placeholder="XXX" @bind="VM.compte.Pseudo" required>
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" placeholder="votre@email.com" @bind="VM.compte.Email" required>
                    </div>
                    <div class="form-group" style="@((VM.memeMotDePasse) ? "" : "background-color: red;")">
                        <label>Mot de passe</label>
                        <input type="password" placeholder="••••••••" @bind="VM.compte.MotDePasse" required>
                    </div>
                    <div class="form-group" style="@((VM.memeMotDePasse) ? "" : "background-color:red;")">
                        <label>Confirmer le mot de passe</label>
                        <input type="password" placeholder="••••••••" @bind="VM.motDePasse" required>
                    </div>
                    <div class="form-group">
                        <label>Date de naissance</label>
                        <input type="date" @bind="VM.compte.DateNaissance" required>
                    </div>
                    <div class="form-group">
                        <label>Biographie</label>
                        <input type="text" placeholder="XXXXXX" @bind="VM.compte.Biographie">
                    </div>
                    <div class="form-group" style="display: flex; align-items: center;">
                        <input @onchange="VM.ReloadPage" type="checkbox" id="is-pro-checkbox">
                        <label for="is-pro-checkbox" style="margin-bottom: 0; cursor: pointer;">
                            Je suis un professionnel
                        </label>
                    </div>

                    @if (VM.pro)
                    {
                        <div class="form-group">
                            <label>Numéro de SIRET</label>
                            <input type="text" placeholder="123 456 789 00010" @bind="VM.compte.NumeroSiret">
                        </div>
                        <div class="form-group">
                            <label>Raison sociale</label>
                            <input type="text" placeholder="Google" @bind="VM.compte.RaisonSociale">
                        </div>
                    }

                    <button type="button" @onclick="VM.CreateCompteAsync" class="btn-submit">S'inscrire</button>

                    @if (VM.messageErreur != null)
                    {
                        <label class="error-message">@VM.messageErreur</label>
                    }
                </form>
            }

            <div class="auth-switch">
                Déjà un compte ? <a href="connexion">Se connecter</a>
            </div>
        }
        else
        {
            <!-- ÉTAPE 2 : ACTIVATION A2F OPTIONNELLE -->
            <div class="a2f-setup">
                <div class="info-box security">
                    <span class="info-icon">🔐</span>
                    <div>
                        <h4>Sécurisez votre compte</h4>
                        <p>Activez l'authentification à deux facteurs pour une sécurité renforcée.</p>
                    </div>
                </div>

                @if (!VM.codeA2fEnvoye)
                {
                    <!-- Choix : Activer ou Skip -->
                    <div class="a2f-choice">
                        <p class="a2f-description">
                            L'authentification à deux facteurs ajoute une couche de sécurité supplémentaire en demandant un code à chaque connexion.
                        </p>

                        <button type="button"
                                class="btn-submit"
                                @onclick="VM.EnvoyerCodeA2f"
                                disabled="@VM.isLoadingA2f">
                            @if (VM.isLoadingA2f)
                            {
                                <span>Envoi en cours...</span>
                            }
                            else
                            {
                                <span>🔒 Activer l'A2F</span>
                            }
                        </button>

                        <button type="button"
                                class="btn-skip"
                                @onclick="VM.SkipA2f"
                                disabled="@VM.isLoadingA2f">
                            Passer cette étape
                        </button>
                    </div>
                }
                else
                {
                    <!-- Saisie du code A2F -->
                    @if (!string.IsNullOrEmpty(VM.messageErreur))
                    {
                        <div class="error-message-box">
                            @VM.messageErreur
                        </div>
                    }

                    <div class="success-message-box">
                        ✓ Un code a été envoyé à votre adresse email
                    </div>

                    <form>
                        <div class="form-group">
                            <label>Code de vérification</label>
                            <input type="text"
                                   placeholder="1234567"
                                   @bind="VM.codeA2f"
                                   disabled="@VM.isLoadingA2f"
                                   maxlength="7"
                                   class="code-input"
                                   required>
                        </div>

                        <button type="button"
                                class="btn-submit"
                                @onclick="VM.ValiderCodeA2f"
                                disabled="@VM.isLoadingA2f">
                            @if (VM.isLoadingA2f)
                            {
                                <span>Validation...</span>
                            }
                            else
                            {
                                <span>Valider et activer l'A2F</span>
                            }
                        </button>
                    </form>

                    <div class="a2f-actions">
                        <button type="button"
                                class="btn-link"
                                @onclick="VM.EnvoyerCodeA2f"
                                disabled="@VM.isLoadingA2f">
                            Renvoyer le code
                        </button>
                        <button type="button"
                                class="btn-link"
                                @onclick="VM.SkipA2f"
                                disabled="@VM.isLoadingA2f">
                            Passer cette étape
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await VM.InitializeAsync(StateHasChanged, nav);
    }
}